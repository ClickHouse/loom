# Loom configuration template. Copy to `.env` and fill in what you need:
#   cp .env.example .env        (`loom up` and `make dev` do this for you)
#
# `.env` is git-ignored; keep credentials out of the repo. The values below are
# local-dev placeholders: never reuse them in a deployment reachable by other
# people (see SECURITY.md and docs/operations/deployment.md#required-environment).
#
# This file lists what a deployment needs plus the knobs a deployer is
# expected to set. Every other setting is an env var `LOOM_<FIELD>` with a
# working default; docs/reference/configuration.md lists them all.
#
# Stock values boot the no-credentials laptop stack that docs/getting-started/quickstart.md
# describes (single-user mode, fake providers);
# tests/unit/test_stock_env_matches_docs.py fails if the two drift.

# Local Compose identity and host exposure. `loom up` fills a unique project
# name into the generated .env so different checkouts never share volumes.
# Keep loopback binding in single-user mode. Before changing it, enable auth
# and put TLS at a reverse proxy (docs/operations/deployment.md).
COMPOSE_PROJECT_NAME=
LOOM_BIND_HOST=127.0.0.1

# ---------------------------------------------------------------
# ClickHouse (required)
# ---------------------------------------------------------------
# `bundled` starts compose.yaml's own ClickHouse container. Leave it empty
# and set LOOM_CH_* to use a self-managed server or ClickHouse Cloud, then run
# `loom ch-setup` once (docs/operations/deployment.md).
COMPOSE_PROFILES=bundled
# Unset, compose.yaml connects to the bundled container and `make server` to
# localhost:8123, both as loom/loomdev. For ClickHouse Cloud use the service's
# HTTPS endpoint: port 8443, user `default` or one made for Loom.
# LOOM_CH_HOST=localhost
# LOOM_CH_PORT=8123                 # 8443 = HTTPS
# LOOM_CH_USER=loom
# LOOM_CH_PASSWORD=loomdev          # development placeholder: set a real one
# LOOM_CH_SECURE=true               # TLS; unset = inferred from the port (8443 -> on)
# LOOM_CH_READER_USER=loom_reader   # runs the reads a caller shapes; made by `loom ch-setup`; empty: LOOM_CH_USER

# ---------------------------------------------------------------
# Auth and identity
# ---------------------------------------------------------------
# Identity mode: single-user (no auth, laptop only), trust-network (self-signup,
# first claim of a namespace wins admin) or gateway (an upstream IdP mints Loom
# JWTs with the shared secret). Empty = inferred: auth off -> single-user;
# auth on + LOOM_SELF_SIGNUP=open -> trust-network; otherwise gateway.
LOOM_IDENTITY_PROVIDER=
# STOCK DEV DEFAULT: auth off, so `make dev` boots with no login into the one
# namespace `dev/local`. Set true (code default) for any shared deployment; the
# dev compose pins LOOM_SELF_SIGNUP=open, so this one line gives the sign-up flow.
LOOM_AUTH_REQUIRED=false
# Browser self-signup in the dashboard: open or off (default). trust-network mode only.
LOOM_SELF_SIGNUP=off
# LOOM_SELF_SIGNUP_ORG=dev          # org self-signed accounts land in; default dev
# LOOM_DEFAULT_NAMESPACE=local      # the one namespace single-user mode serves; default local
# Comma-separated emails promoted to platform admin at login (org-wide Usage,
# Health, Users, Erasures). `loom set-host <email>` writes it. Default: none.
LOOM_PLATFORM_ADMINS=
# The root secret, and the one secret to carry when this deployment moves: it
# signs tokens (kid `default`) and seals stored credentials and the signing
# keys in ClickHouse. Required when auth is on. Generate one with
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
LOOM_JWT_SECRET=
# Rotation needs no env change: `loom signing-key rotate [--algorithm RS256]`
# adds a key in ClickHouse, `loom signing-key retire <kid>` stops one.
# Changing LOOM_JWT_SECRET itself: put the old value here so credentials sealed under
# it still open, follow the root-secret steps in docs/operations/deployment.md
# ("Identity and authentication"), and remove this once `loom secrets reseal --check`
# exits 0.
# LOOM_JWT_SECRET_PREVIOUS=
# The bearer token between Loom and its document extractor service (extractor/),
# which `make dev` runs beside it at http://extractor:8790. `loom up` and
# `make bootstrap` generate it; the extractor refuses to start without one.
LOOM_DOCUMENT_EXTRACTOR_TOKEN=
# A gateway whose RS256 tokens this deployment accepts: kid -> PEM public key.
# LOOM_JWT_PUBLIC_KEYS_JSON={"gw1":"-----BEGIN PUBLIC KEY-----..."}
# gateway mode: subjects allowed to send X-Loom-On-Behalf-Of; empty (default) = none.
# LOOM_TRUSTED_CALLERS=my-gateway
# OAuth 2.1 one-click MCP connect (default off). The issuer is the public HTTPS
# base URL the discovery metadata advertises; empty = derived per request.
# LOOM_OAUTH_ENABLED=true
# LOOM_OAUTH_ISSUER=https://loom.example.com
# Sign-in for /oauth/authorize through an external OIDC IdP instead of the
# built-in password form (default `password`); needs all three oidc values.
# LOOM_OAUTH_LOGIN_PROVIDER=oidc
# LOOM_OIDC_ISSUER=https://idp.example.com
# LOOM_OIDC_CLIENT_ID=<client id>
# LOOM_OIDC_CLIENT_SECRET=<client secret>
# Browser origins allowed by CORS, comma-separated; empty (default) = CORS off.
# `*` is refused at startup (CORS allows credentials).
# LOOM_CORS_ORIGINS=https://app.example.com

# ---------------------------------------------------------------
# Public URL
# ---------------------------------------------------------------
# Address handed to clients (a new token's client setups, `claude mcp add`,
# claim links, OAuth metadata). Required when LOOM_BIND_HOST is not loopback;
# empty (default) = the request's own Host.
# LOOM_PUBLIC_BASE_URL=https://loom.example.com
# Proxies whose X-Forwarded-For/Proto are honoured (addresses or CIDRs). A
# proxy on the host in front of a compose stack arrives from the Docker
# network's gateway (docs/operations/deployment.md, "Proxy and TLS").
# LOOM_TRUSTED_PROXIES=127.0.0.1
# A non-loopback bind refuses to start with auth off, MCP open mode, the dev JWT
# secret or a weak root, gateway or end-user key; 1 overrides that, only for a port
# nobody else can reach.
# LOOM_ALLOW_INSECURE=0

# ---------------------------------------------------------------
# Embedder and LLM providers
# ---------------------------------------------------------------
# STOCK DEV DEFAULT: the fake embedder and fake LLM are pinned on purpose.
# `make dev` passes this file as `--env-file`, so these lines win over the
# compose file's OpenAI fallbacks and setting OPENAI_API_KEY alone changes
# nothing. For real providers, replace the four lines with this block before
# the first boot (or run `make down-all` first: the vector width is fixed when
# the tables are created, and a live namespace needs `loom reembed`):
#   LOOM_EMBEDDING_MODEL=text-embedding-3-large
#   LOOM_EMBEDDING_DIM=3072
#   LOOM_LLM_PROVIDER=openai
#   LOOM_LLM_MODEL=gpt-6-luna
#   OPENAI_API_KEY=sk-...
# Embedder: fake-ngram-3072 (default, no network, meaningless ranking),
# local / local:bge-small / local:bge-base / local:minilm (CPU, image built with
# a local* value), text-embedding-3-small / -large (OpenAI),
# gemini-embedding-001 (Gemini). Widths per model: docs/operations/deployment.md#providers.
# LOOM_EMBEDDING_DIM must match the embedder's width; Loom's default is 3072.
LOOM_EMBEDDING_MODEL=fake-ngram-3072
LOOM_EMBEDDING_DIM=3072
# LLM: fake, openai or anthropic. Empty (code default) = inferred from the model
# name, else from the key present, else fake. Empty model = the provider's
# default (gpt-6-luna / claude-haiku-4-5 / fake-echo-1).
LOOM_LLM_PROVIDER=fake
LOOM_LLM_MODEL=fake-echo-1
# Provider keys; each is needed only by the provider that names it.
# OPENAI_API_KEY: text-embedding-3-* embedders and the openai LLM.
OPENAI_API_KEY=
# Other embedding services with an OpenAI-compatible API:
# LOOM_EMBEDDING_PROVIDER=compatible
# LOOM_EMBEDDING_BASE_URL=https://embedding-provider.example/v1
# LOOM_EMBEDDING_MODEL=your-embedding-model
# LOOM_EMBEDDING_DIM=768
# LOOM_EMBEDDING_API_KEY=
# LOOM_EMBEDDING_SEND_DIMENSIONS=false
# ANTHROPIC_API_KEY=                # anthropic LLM
# GEMINI_API_KEY=                   # gemini-embedding-001 (GOOGLE_API_KEY also accepted)
# COHERE_API_KEY=                   # only when a rerank endpoint names builtin:cohere
# true: a fake or keyless provider turns /v1/health `degraded`; default false.
# LOOM_REQUIRE_REAL_PROVIDERS=true
# Model that answers when the primary provider keeps failing; empty (default) = fail.
# LOOM_LLM_FALLBACK_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------
# Process and scale
# ---------------------------------------------------------------
# Every process outside the deployment's compose files must name itself
# (`<who>:<what>:<port>`) or it refuses to start; the compose files set
# LOOM_DEPLOYMENT=1 and their own labels, so never set LOOM_DEPLOYMENT here.
# LOOM_INSTANCE_LABEL=dev:my-server:7777
# LOOM_WEB_WORKERS=4                # uvicorn processes per container; unset = one per CPU, one per GiB, at most 8
# LOOM_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:<release>  # pin a release (:head is a master build); CI tests the latest release
# LOOM_REPLICA_COUNT=1              # floor of the counted replicas (live loom.instances rows) that divide rate limits; default 1
# Scales every op's latency budget; default 1.0. ~20 when ClickHouse is across a WAN.
# LOOM_LATENCY_BUDGET_MULTIPLIER=20
# LOOM_LOG_FORMAT=json              # text (default) or json for a log pipeline
# LOOM_DEFAULT_DAILY_COST_CAP_USD=1.0   # per-namespace daily LLM spend cap; 0 = off; default 1.0

# ---------------------------------------------------------------
# Telemetry (OpenTelemetry)
# ---------------------------------------------------------------
# Exporter: ch writes spans, logs and metrics into the otel_* tables of the same
# ClickHouse; otlp ships to a collector. Empty (default) = ch unless an endpoint is set.
# LOOM_OTEL_EXPORTER=otlp
# LOOM_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com:4318
# LOOM_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# LOOM_OTEL_ENVIRONMENT=prod        # deployment.environment.name on every span; default dev

# ---------------------------------------------------------------
# Erasure integrations (each off unless set)
# ---------------------------------------------------------------
# An erasure request also deletes the user's data in these systems.
# Langfuse: traces via its admin API; both values required.
# LOOM_LANGFUSE_URL=https://langfuse.example.com
# LOOM_LANGFUSE_ADMIN_TOKEN=<admin token>
# ClickStack / HyperDX: the database its collector writes the otel_* tables to.
# LOOM_CLICKSTACK_DATABASE=default
# Map-attribute keys that carry user identity; default user_id,user.id,enduser.id,loom.user_id,langfuse.user.id.
# LOOM_CLICKSTACK_USER_ID_KEYS=user_id,user.id,enduser.id,loom.user_id,langfuse.user.id

# ---------------------------------------------------------------
# Code intelligence (off until a repository is configured)
# ---------------------------------------------------------------
# Repositories can also be added from the Repositories page. Runbook:
# docs/operations/code-index-operations.md. One repository, or a JSON array for several
# (wrap the JSON in single quotes so compose, python-dotenv and a shell agree):
# LOOM_CODE_REPO=acme/myrepo        # owner/name
# LOOM_CODE_ORG=acme                # loom org of the code namespace
# LOOM_CODE_NAMESPACE=code-myrepo   # the code namespace and the code.* default
# LOOM_CODE_REPOS_JSON='[{"namespace":"code-myrepo","repo":"acme/myrepo"},{"namespace":"code-other","repo":"acme/other","path_prefixes":"src/"}]'
# LOOM_CODE_GITHUB_TOKEN=<token>    # private clones and PR history; empty = public clones, no PR sync
# The stock single-node stack enables the non-LLM indexing workers so repositories
# added in the dashboard make progress without a second setup step.
# Per-merge fast tier (tree-sitter + embeddings).
LOOM_CODE_INGEST_ENABLED=true
# LOOM_CODE_PR_HISTORY_ENABLED=true # merged-PR sync (needs the GitHub token)
# Re-embed code rows whose embedding failed.
LOOM_CODE_EMBED_RECOVERY_ENABLED=true
# Weekly PageRank and test map.
LOOM_CODE_GRAPH_STATS_ENABLED=true
# LOOM_CODE_SUMMARY_ENABLED=true          # weekly LLM file/module cards
# LOOM_CODE_SCIP_APPLY_ENABLED=true       # compiler tier from uploaded SCIP deltas
# Compiler tiers are on by default. The Docker image includes the Python,
# TypeScript and Go indexers; C/C++ additionally needs scip-clang and a
# project compilation database. Set a flag false to disable that worker.
# C/C++ (scip-clang)
LOOM_CODE_SCIP_DELTA_ENABLED=true
# Python (scip-python)
LOOM_CODE_SCIP_PY_DELTA_ENABLED=true
# TypeScript / JavaScript (scip-typescript)
LOOM_CODE_SCIP_TS_DELTA_ENABLED=true
# Go (scip-go)
LOOM_CODE_SCIP_GO_DELTA_ENABLED=true
# List code.* tools on the default MCP toolset.
LOOM_MCP_CODE_TOOLS=true
# LOOM_CODE_ORG_READABLE=true       # every org member reads every code namespace; default false

# ---------------------------------------------------------------
# Tracker records (off until sources are configured)
# ---------------------------------------------------------------
# Issue/QA records read from ClickHouse sources: docs/features/tracker/record-contract.md.
# LOOM_TRACKER_ORG=acme             # loom org of the tracker namespaces; empty = none serve
# LOOM_TRACKER_SOURCES_JSON='{"sources":{"main":{"host":"tracker.example.com","port":8443,"secure":true,"database":"tracker"}},"namespaces":{"tracker-myrepo":{"source":"main","repos":["acme/myrepo"]}}}'
# LOOM_TRACKER_CREDENTIALS_JSON='{"main":{"user":"reader","password":"<password>"}}'
# LOOM_TRACKER_CODE_NAMESPACE_BINDINGS_JSON='{"code-myrepo*":"tracker-myrepo"}'
