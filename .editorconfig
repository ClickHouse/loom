root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true

# The launcher has no .sh extension; shfmt reads no brace lists.
[integrations/*/bin/loom-node]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
