+function capSize(inst: $ZodType) {
+  const type = inst._zod.def.type;
+  if (type !== "array" && type !== "map" && type !== "set") return;
+  const caps: [number, checks.$ZodCheck<never>][] = [];
+  for (const check of inst._zod.def.checks ?? []) {
+    const definition = check._zod.def as any;
+    if (!/_(length|size)$|_equals$/.test(definition.check)) break;
+    const maximum = definition.maximum ?? definition.length ?? definition.size;
+    if (maximum >= 0) caps.push([maximum, check]);
+  }
+  if (!caps.length) return;
+  const run = inst._zod.run;
+  inst._zod.run = (payload, ctx) => {
+    const value = payload.value;
+    const size = type === "array" ? (Array.isArray(value) ? value.length : -1) :
+      type === "map" ? (value instanceof Map ? value.size : -1) : (value instanceof Set ? value.size : -1);
+    for (const [maximum, check] of caps) {
+      if (size > maximum && (!check._zod.def.when || check._zod.def.when(payload))) {
+        const start = payload.issues.length;
+        check._zod.check(payload as ParsePayload<never>);
+        if (payload.issues.length > start) {
+          (payload.issues[start] as { continue?: boolean }).continue = false;
+          return payload;
+        }
+      }
+    }
+    return run(payload, ctx);
+  };
+}
