{
  "name": "@clickhouse/n8n-nodes-loom",
  "version": "0.1.0",
  "description": "Loom memory and document search for n8n agents.",
  "license": "MIT",
  "author": {
    "name": "ClickHouse, Inc.",
    "email": "security@clickhouse.com"
  },
  "homepage": "https://clickhouse.github.io/loom/features/integrations/frameworks/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickHouse/loom.git",
    "directory": "integrations/n8n"
  },
  "keywords": [
    "n8n-community-node-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "n8n-node build && node scripts/bundle.mjs",
    "lint": "n8n-node lint",
    "dev": "n8n-node dev",
    "test": "node --test test/*.test.cjs",
    "check": "npm run build && npm run lint && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/LoomApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Loom/Loom.node.js",
      "dist/nodes/LoomMemory/LoomMemory.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.56.4",
    "n8n-workflow": "2.47.2",
    "@types/node": "^24",
    "typescript": "5.9.3",
    "eslint": "9.29.0",
    "@clickhouse/loom": ">=1.2.0 <2",
    "@langchain/classic": "1.0.27",
    "@langchain/core": "1.4.0",
    "prettier": "3.8.3",
    "esbuild": "0.27.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.32.1"
}
