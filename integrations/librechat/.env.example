# LibreChat v0.8.8 settings read by docker-compose.yml. Fill the four secrets with
# `openssl rand -hex 32` (CREDS_IV: `openssl rand -hex 16`) and never commit the filled file.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Email sign-in with self-registration, for a local evaluation. Use your identity
# provider in a shared deployment.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# The model provider. The qualification ran with the model listed here.
ENDPOINTS=anthropic,agents
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-haiku-4-5-20251001

# The browser-facing address. Use the same port as LIBRECHAT_PORT below.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Read by docker-compose.yml itself, from the shell or this file:
# LIBRECHAT_PORT=3080          # the host port, bound to 127.0.0.1
# LIBRECHAT_ENV_FILE=.env      # the file passed to the container
# LIBRECHAT_CONFIG=./librechat.yaml
