{
  "mcpServers": {
    "loom": {
      "type": "http",
      "url": "${user_config.server_url}/mcp?toolset=${user_config.toolset}",
      "headersHelper": "sh \"$CLAUDE_PLUGIN_ROOT/bin/loom-node\" \"$CLAUDE_PLUGIN_ROOT/bin/loom-mcp-headers.mjs\" \"${CLAUDE_PROJECT_DIR}\" || node -e \"if(process.versions.node.split('.')[0]<18)process.exit(1);const p=require('path').join(process.env.CLAUDE_PLUGIN_ROOT,'bin','loom-mcp-headers.mjs');process.argv.splice(1,0,p);import(require('url').pathToFileURL(p).href)\" \"${CLAUDE_PROJECT_DIR}\""
    }
  }
}
