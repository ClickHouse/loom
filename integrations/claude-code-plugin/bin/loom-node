#!/bin/sh
# LF line endings only (.gitattributes): sh reads a CR as part of a command.
# Runs a plugin script under Node.js 18+ wherever Node is installed. Hooks and
# the MCP header helper start with the agent's own environment, and an agent
# started from the Dock, a desktop launcher or a shell whose version manager
# edits only the interactive PATH has no `node` on it.
#   loom-node <script> [args...]   exec the script under the Node found
#   loom-node --check              print the Node found; exit 1 when none
# The first Node 18+ wins: $LOOM_NODE, `node` on PATH, a version manager's
# default (its newest install when it has none we can read), then the usual
# install directories. Stdout is the script's own: a hook's stdout is its
# payload. Git Bash opens Windows paths as they are.

if [ $# -eq 0 ]; then
  echo 'usage: loom-node <script> [args...] | --check' >&2
  exit 1
fi

found=''
found_version=''
too_old=''
too_old_version=''

# usable <file>: Node 18+ sets found and found_version; the first older
# Node sets too_old and too_old_version
usable() {
  [ -f "$1" ] && [ -x "$1" ] || return 1
  v=$("$1" --version 2>/dev/null) || return 1
  m=${v#v}
  m=${m%%.*}
  case $m in '' | *[!0-9]*) return 1 ;; esac
  if [ "$m" -ge 18 ]; then
    found=$1
    found_version=$v
    return 0
  fi
  if [ -z "$too_old" ]; then
    too_old=$1
    too_old_version=$v
  fi
  return 1
}

# in_dir <dir>: node, or node.exe under Git Bash
in_dir() {
  [ -n "$1" ] || return 1
  usable "$1/node" || usable "$1/node.exe"
}

# version_key <name>: sets key to v22.1.0 or 22.1 as one comparable number
version_key() {
  n=${1#v}
  case $n in [0-9]*.[0-9]*) ;; *) return 1 ;; esac
  major=${n%%.*}
  rest=${n#*.}
  minor=${rest%%.*}
  patch=${rest#*.}
  [ "$patch" = "$rest" ] && patch=0
  patch=${patch%%[!0-9]*}
  case $major$minor in *[!0-9]*) return 1 ;; esac
  key=$((major * 1000000 + minor * 1000 + ${patch:-0}))
}

# newest <root> <bin> [version]: the Node in <bin> (empty: the directory
# itself) of the highest version directory under <root> that has one, or the
# highest within [version] (22, 22.1). Versions are tried from the top, so
# usually one Node runs.
newest() {
  below=1000000000000
  while :; do
    best=''
    best_key=-1
    for d in "$1"/*; do
      n=${d##*/}
      if [ -n "${3:-}" ]; then
        case ${n#v} in "${3#v}" | "${3#v}".*) ;; *) continue ;; esac
      fi
      version_key "$n" || continue
      if [ "$key" -lt "$below" ] && [ "$key" -gt "$best_key" ]; then
        best=$d
        best_key=$key
      fi
    done
    [ -n "$best" ] || return 1
    in_dir "$best${2:+/$2}" && return 0
    below=$best_key
  done
}

# default_or_newest <root> <bin> <version>: the install the manager's
# default names, else its newest
default_or_newest() {
  if [ -n "$3" ] && newest "$1" "$2" "$3"; then
    return 0
  fi
  newest "$1" "$2"
}

from_fnm() {
  in_dir "$1/aliases/default/bin" && return 0
  in_dir "$1/aliases/default" && return 0
  newest "$1/node-versions" installation/bin && return 0
  newest "$1/node-versions" installation
}

# nvm's default is a version, or an alias (lts/iron) whose file names one.
from_nvm() {
  want=''
  [ -f "$1/alias/default" ] && read -r want <"$1/alias/default"
  for _ in 1 2; do
    if [ -n "$want" ] && [ -f "$1/alias/$want" ]; then
      read -r want <"$1/alias/$want"
    fi
  done
  case $want in [0-9]* | v[0-9]*) ;; *) want='' ;; esac
  default_or_newest "$1/versions/node" bin "$want"
}

# asdf's default is the `nodejs <version>` line of ~/.tool-versions.
from_asdf() {
  want=''
  if [ -f "$HOME/.tool-versions" ]; then
    while read -r tool version _ || [ -n "$tool" ]; do
      [ "$tool" = nodejs ] && want=$version
    done <"$HOME/.tool-versions"
  fi
  default_or_newest "$1/installs/nodejs" bin "$want"
}

from_nodenv() {
  want=''
  [ -f "$1/version" ] && read -r want <"$1/version"
  default_or_newest "$1/versions" bin "$want"
}

find_node() {
  if [ -n "${LOOM_NODE:-}" ]; then
    usable "$LOOM_NODE"
    return
  fi
  p=$(command -v node 2>/dev/null) && usable "$p" && return 0
  data=${XDG_DATA_HOME:-$HOME/.local/share}
  [ -n "${FNM_DIR:-}" ] && from_fnm "$FNM_DIR" && return 0
  from_fnm "$data/fnm" && return 0
  from_fnm "$HOME/Library/Application Support/fnm" && return 0
  from_fnm "$HOME/.fnm" && return 0
  from_nvm "${NVM_DIR:-$HOME/.nvm}" && return 0
  in_dir "${VOLTA_HOME:-$HOME/.volta}/bin" && return 0
  from_asdf "${ASDF_DATA_DIR:-$HOME/.asdf}" && return 0
  newest "${MISE_DATA_DIR:-$data/mise}/installs/node" bin && return 0
  from_nodenv "${NODENV_ROOT:-$HOME/.nodenv}" && return 0
  # n puts the active version in its prefix (/usr/local/bin, below, by
  # default) and keeps the others under n/.
  if [ -n "${N_PREFIX:-}" ]; then
    in_dir "$N_PREFIX/bin" && return 0
    newest "$N_PREFIX/n/versions/node" bin && return 0
  fi
  in_dir "$HOME/.nodebrew/current/bin" && return 0
  # Windows, under Git Bash: nvm-windows, fnm, Volta, Scoop, the installer.
  if [ -n "${APPDATA:-}${LOCALAPPDATA:-}" ]; then
    in_dir "${NVM_SYMLINK:-}" && return 0
    [ -n "${NVM_HOME:-}" ] && newest "$NVM_HOME" '' && return 0
    [ -n "${APPDATA:-}" ] && from_fnm "$APPDATA/fnm" && return 0
    [ -n "${LOCALAPPDATA:-}" ] && in_dir "$LOCALAPPDATA/Volta/bin" && return 0
    in_dir "${SCOOP:-$HOME/scoop}/apps/nodejs/current" && return 0
    in_dir "${SCOOP:-$HOME/scoop}/apps/nodejs-lts/current" && return 0
    in_dir "${PROGRAMFILES:-C:/Program Files}/nodejs" && return 0
  fi
  # LOOM_NODE_SYSTEM_DIRS replaces the fixed directories (colon-separated).
  dirs=${LOOM_NODE_SYSTEM_DIRS-/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:/usr/bin:/bin:/snap/bin:/opt/local/bin}
  set -f
  old_ifs=$IFS
  IFS=:
  set -- $dirs
  IFS=$old_ifs
  set +f
  for d in "$@"; do
    in_dir "$d" && return 0
  done
  return 1
}

if ! find_node; then
  if [ -n "${LOOM_NODE:-}" ]; then
    echo "loom: LOOM_NODE=$LOOM_NODE is not Node.js 18+${too_old_version:+ (it is $too_old_version)}." >&2
  elif [ -n "$too_old" ]; then
    echo "loom: Node.js 18+ is required; the first Node found, $too_old ($too_old_version), is older. Install a newer one, or set LOOM_NODE=/path/to/node." >&2
  else
    echo 'loom: Node.js 18+ not found on PATH or in the usual install locations. Install it, or set LOOM_NODE=/path/to/node.' >&2
  fi
  exit 1
fi

if [ "${1:-}" = --check ]; then
  # fnm's per-shell link goes away with the shell: name the directory it points at.
  case $found in
    */fnm_multishells/*)
      if dir=$(cd -P "${found%/*}" 2>/dev/null && pwd -P); then
        found=$dir/${found##*/}
      fi
      ;;
  esac
  printf 'Loom hook runtime ready: %s (%s)\n' "$found" "$found_version"
  exit 0
fi
exec "$found" "$@"
