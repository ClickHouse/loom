{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-session-start.mjs\" SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-prompt-pack.mjs\" UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-prompt-recall.mjs\" UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-run.mjs\" UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-code-shunt.mjs\" PreToolUse"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-file-context.mjs\" PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__loom__.*|mcp__plugin_loom_loom__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-mentor-hint.mjs\" PostToolUse"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-blast-radius.mjs\" PostToolUse"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-capture.mjs\" PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-capture.mjs\" PostToolUseFailure"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-capture.mjs\" PreCompact"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-working-memory.mjs\" PreCompact"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-session-brief.mjs\" PreCompact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-capture.mjs\" Stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-conversation.mjs\" Stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-usage.mjs\" Stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-test-gate.mjs\" Stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-validate-gate.mjs\" Stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-namespace-health.mjs\" Stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-working-memory.mjs\" Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-capture.mjs\" SessionEnd",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-conversation.mjs\" SessionEnd",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-run.mjs\" SessionEnd",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-session-memory.mjs\" SessionEnd",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/loom-node\" \"${CLAUDE_PLUGIN_ROOT}/hooks/loom-session-brief.mjs\" SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
