<!--
  CI only: no user on this server may change log_queries, as on ClickHouse Cloud,
  so a statement or settings profile that turns query logging off fails here
  as it does there.
-->
<clickhouse>
    <profiles>
        <default>
            <constraints>
                <log_queries>
                    <readonly/>
                </log_queries>
            </constraints>
        </default>
    </profiles>
</clickhouse>
