# Preserve committed LF bytes for shell launchers and skill frontmatter.
# Disabling conversion also keeps these bytes unchanged with autocrlf enabled.
# The checkout-byte tests reject CRLF in the committed files.
*.sh -text
integrations/*/bin/loom-node -text
integrations/grep-shim/bin/* -text
integrations/cline/hooks/* -text
integrations/*/skills/** -text
skills/** -text
