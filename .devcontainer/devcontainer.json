{
  // A try-out of Loom in GitHub Codespaces: the released stack, started by the
  // released installer, with Claude Code connected to it. Port 7777 is
  // forwarded privately, to the signed-in GitHub user only.
  "name": "Loom try-out",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // The install lives outside the home directory, which a rebuild replaces, so a
  // rebuilt container finds the same .env and Compose project.
  "containerEnv": { "LOOM_INSTALL_DIR": "/workspaces/.loom" },
  // ClickHouse, the server and the document extractor, with about 3 GB of images.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [7777],
  "portsAttributes": {
    // requireLocalPort: desktop VS Code forwards to the laptop's localhost:7777 or
    // reports the clash, rather than another port, whose Origin the server refuses.
    "7777": {
      "label": "Loom dashboard",
      "onAutoForward": "openBrowser",
      "visibility": "private",
      "requireLocalPort": true
    }
  },
  // A resumed codespace starts the stack again by itself: every service restarts
  // unless stopped.
  "postCreateCommand": "sh .devcontainer/start-loom.sh"
}
