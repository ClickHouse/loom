{
  "name": "Loom source contribution",
  "build": { "dockerfile": "Dockerfile", "context": "." },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/loom-source,type=bind",
  "workspaceFolder": "/workspaces/loom-source",
  "remoteUser": "developer",
  "forwardPorts": [],
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/venv/bin/python",
        "remote.autoForwardPorts": false
      }
    }
  },
  "postCreateCommand": "bash dev/contributor-lab/bootstrap.sh functional"
}
