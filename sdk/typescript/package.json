{
  "name": "@clickhouse/loom",
  "version": "1.3.0",
  "description": "TypeScript SDK for ClickHouse Loom, a self-hosted server that gives AI agents shared long-term memory, document search and a code index. Typed over every wire operation the server declares, with retries, rate-limit pacing, idempotency keys and an Agent identity binding.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./integrations/ai-sdk": {
      "import": {
        "types": "./dist/integrations/ai-sdk.d.mts",
        "default": "./dist/integrations/ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/integrations/ai-sdk.d.cts",
        "default": "./dist/integrations/ai-sdk.cjs"
      }
    },
    "./integrations/claude-memory": {
      "import": {
        "types": "./dist/integrations/claude-memory.d.mts",
        "default": "./dist/integrations/claude-memory.mjs"
      },
      "require": {
        "types": "./dist/integrations/claude-memory.d.cts",
        "default": "./dist/integrations/claude-memory.cjs"
      }
    },
    "./integrations/google-adk": {
      "import": {
        "types": "./dist/integrations/google-adk.d.mts",
        "default": "./dist/integrations/google-adk.mjs"
      },
      "require": {
        "types": "./dist/integrations/google-adk.d.cts",
        "default": "./dist/integrations/google-adk.cjs"
      }
    },
    "./integrations/langchain": {
      "import": {
        "types": "./dist/integrations/langchain.d.mts",
        "default": "./dist/integrations/langchain.mjs"
      },
      "require": {
        "types": "./dist/integrations/langchain.d.cts",
        "default": "./dist/integrations/langchain.cjs"
      }
    },
    "./integrations/langgraph": {
      "import": {
        "types": "./dist/integrations/langgraph.d.mts",
        "default": "./dist/integrations/langgraph.mjs"
      },
      "require": {
        "types": "./dist/integrations/langgraph.d.cts",
        "default": "./dist/integrations/langgraph.cjs"
      }
    },
    "./integrations/mastra": {
      "import": {
        "types": "./dist/integrations/mastra.d.mts",
        "default": "./dist/integrations/mastra.mjs"
      },
      "require": {
        "types": "./dist/integrations/mastra.d.cts",
        "default": "./dist/integrations/mastra.cjs"
      }
    },
    "./integrations/openai-agents": {
      "import": {
        "types": "./dist/integrations/openai-agents.d.mts",
        "default": "./dist/integrations/openai-agents.mjs"
      },
      "require": {
        "types": "./dist/integrations/openai-agents.d.cts",
        "default": "./dist/integrations/openai-agents.cjs"
      }
    },
    "./integrations/strands": {
      "import": {
        "types": "./dist/integrations/strands.d.mts",
        "default": "./dist/integrations/strands.mjs"
      },
      "require": {
        "types": "./dist/integrations/strands.d.cts",
        "default": "./dist/integrations/strands.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run -c vitest.dist.config.ts",
    "test:integ": "vitest run -c vitest.integ.config.ts",
    "check:version": "node scripts/check-version.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check": "npm run lint && npm run type-check && npm run check:version && npm run check:readme && npm run test",
    "check:dist": "npm run build && npm run test:dist && npm run check:package",
    "prepublishOnly": "npm run check && npm run check:dist",
    "docs": "npm ci --prefix ../../.github/pnpm --ignore-scripts --no-audit --no-fund && node ../../.github/pnpm/node_modules/pnpm/bin/pnpm.cjs --dir ../../.github/sdk-docs install --frozen-lockfile --ignore-scripts && node ../../.github/sdk-docs/node_modules/typedoc/bin/typedoc"
  },
  "keywords": [
    "loom",
    "clickhouse",
    "mcp",
    "agent-memory",
    "long-term-memory",
    "ai-agents",
    "document-search",
    "code-search",
    "rag",
    "knowledge-base",
    "llm",
    "sdk"
  ],
  "author": "ClickHouse, Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickHouse/loom.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/ClickHouse/loom/issues"
  },
  "homepage": "https://loom.clickhouse.com/docs/reference/typescript-sdk/",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.8.0 <1.9.0 || >=1.11.0 <1.12.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@google/adk": ">=2.5.0 <2.6.0",
    "@langchain/core": ">=1.0.0 <2.0.0",
    "@langchain/langgraph-checkpoint": ">=1.2.3 <2.0.0",
    "@mastra/core": ">=1.83.0 <1.84.0",
    "@openai/agents": ">=0.22.0 <0.23.0",
    "ai": ">=7.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@google/adk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@google/adk": "2.5.0",
    "@langchain/core": "1.4.0",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@mastra/core": "1.83.0",
    "@mastra/memory": "1.41.1",
    "@openai/agents": "0.22.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "ai": "7.0.172",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "zod": "4.6.7"
  },
  "overrides": {
    "glob": "14.0.2",
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
