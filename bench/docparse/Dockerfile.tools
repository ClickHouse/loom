FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libreoffice-writer-nogui libreoffice-impress-nogui chromium poppler-utils tesseract-ocr tesseract-ocr-eng \
    fonts-dejavu fonts-liberation fonts-noto-core && rm -rf /var/lib/apt/lists/*
