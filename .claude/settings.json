{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test-unit)",
      "Bash(make schema-check)",
      "Bash(.venv/bin/python -m pytest tests/unit:*)",
      "Bash(.venv/bin/python -m ruff:*)",
      "Bash(npm --prefix frontend run test)",
      "Bash(npm --prefix frontend run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue view:*)",
      "Bash(./redeploy.sh --status)",
      "Bash(npm --prefix frontend run budget)",
      "Bash(npm --prefix sdk/typescript run check)",
      "Bash(node --test:*)",
      "Bash(.venv/bin/python -m scripts.codegen.:*)",
      "Bash(.venv/bin/python -m tests.inventory.coverage_floors:*)",
      "Bash(make migrate-status)"
    ],
    "deny": ["Bash(git stash:*)", "Bash(git push -f:*)"]
  }
}
