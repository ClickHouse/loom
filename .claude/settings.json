{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test-unit)",
      "Bash(make schema-check)",
      "Bash(.venv/bin/python -m ruff:*)",
      "Bash(npm --prefix frontend run test)",
      "Bash(npm --prefix frontend run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue view:*)",
      "Bash(./redeploy.sh --status)",
      "Bash(npm --prefix frontend run budget)",
      "Bash(npm --prefix sdk/typescript run check)",
      "Bash(node --test:*)",
      "Bash(.venv/bin/python -m tests.inventory.coverage_floors:*)",
      "Bash(make migrate-status)",
      "Bash(.venv/bin/python -m pytest tests/unit)",
      "Bash(.venv/bin/python -m pytest tests/unit/*)",
      "Bash(.venv/bin/python -m scripts.codegen.sdk_py_gen:*)",
      "Bash(.venv/bin/python -m scripts.codegen.sdk_py_client_gen:*)",
      "Bash(.venv/bin/python -m scripts.codegen.sdk_ts_gen:*)",
      "Bash(.venv/bin/python -m scripts.codegen.docs_reference:*)",
      "Bash(.venv/bin/python -m scripts.codegen.op_reach_census:*)",
      "Bash(.venv/bin/python -m scripts.codegen.settings_reference:*)",
      "Bash(.venv/bin/python -m scripts.codegen.agent_plugin_sync:*)"
    ],
    "deny": [
      "Bash(git stash:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * v*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(gh workflow run release*)",
      "Bash(gh release create*)",
      "Bash(./redeploy.sh)",
      "Bash(./redeploy.sh --force*)",
      "Bash(./redeploy.sh --rollback*)",
      "Bash(* redeploy.sh)",
      "Bash(* redeploy.sh --force*)",
      "Bash(* redeploy.sh --rollback*)",
      "Bash(docker * dev/docker-compose.colour.yml*)",
      "Bash(docker * dev/docker-compose.proxy.yml*)",
      "Bash(docker * loom-blue*)",
      "Bash(docker * loom-green*)",
      "Bash(docker * loom-proxy*)",
      "Bash(docker * loom-server*)",
      "Bash(docker * loom-workers*)"
    ]
  }
}
