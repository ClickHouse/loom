# Written to .env on first install. Running the install command again preserves .env.
COMPOSE_PROJECT_NAME=__COMPOSE_PROJECT_NAME__
LOOM_VERSION=__LOOM_VERSION__
LOOM_BIND_HOST=127.0.0.1
LOOM_PORT=7777
# Web worker processes. Unset = 2: ClickHouse runs on the same host in this
# stack, so Loom leaves it the rest. Each process can use up to about 1 GiB; on
# a host with cores and memory to spare, 4 serves most loads.
# LOOM_WEB_WORKERS=4
# Run a ClickHouse master build instead of this Loom version's release: uncomment,
# then `docker compose up -d` pulls it. `docker compose pull clickhouse` fetches a
# newer master. CI does not test master, and data a newer server writes may not
# open after switching back to the release.
# LOOM_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:head

# `bundled` runs Loom's own ClickHouse container. The installer's --clickhouse
# URL empties it and sets LOOM_CH_HOST, LOOM_CH_PORT, LOOM_CH_SECURE,
# LOOM_CH_USER and LOOM_CH_PASSWORD for a self-managed server or ClickHouse
# Cloud. To switch, run the install command again with --clickhouse, or add
# those lines here, empty COMPOSE_PROFILES and run
# `docker compose run --rm loom loom ch-setup`.
COMPOSE_PROFILES=bundled

# Safe laptop default: one local user, no login, loopback-only networking.
# Before exposing Loom to a network, use trust-network or gateway mode and TLS.
LOOM_IDENTITY_PROVIDER=single-user
LOOM_AUTH_REQUIRED=false
LOOM_DEFAULT_NAMESPACE=local
LOOM_JWT_SECRET=__LOOM_JWT_SECRET__
# The document extractor service beside Loom (compose.yaml), which parses the
# originals Loom ingests; it holds no other credential and accepts this token.
LOOM_DOCUMENT_EXTRACTOR_URL=http://extractor:8790
LOOM_DOCUMENT_EXTRACTOR_TOKEN=__LOOM_DOCUMENT_EXTRACTOR_TOKEN__

# Credential-free: embeddings come from a small local model the image carries
# (bge-small, 384 dimensions, CPU, no network), so search returns meaningful
# hits; the fake LLM extracts and answers nothing. Configure a real provider for
# answers and stronger retrieval; switching the embedder needs a re-embed.
# Agent subscriptions and Loom's API keys are separate. Setup recipes:
# https://github.com/ClickHouse/loom/blob/main/docs/getting-started/models-and-keys.md
LOOM_EMBEDDING_MODEL=local
LOOM_EMBEDDING_DIM=384
LOOM_LLM_PROVIDER=fake
LOOM_LLM_MODEL=fake-echo-1
OPENAI_API_KEY=
# Other embedding services with an OpenAI-compatible API:
# LOOM_EMBEDDING_PROVIDER=compatible
# LOOM_EMBEDDING_BASE_URL=https://embedding-provider.example/v1
# LOOM_EMBEDDING_MODEL=your-embedding-model
# LOOM_EMBEDDING_DIM=768
# LOOM_EMBEDDING_API_KEY=
# LOOM_EMBEDDING_SEND_DIMENSIONS=false

# Repository indexing: list repositories in LOOM_CODE_REPOS_JSON:
# https://github.com/ClickHouse/loom/blob/main/docs/getting-started/quickstart.md#optional-index-a-repository-on-the-released-stack
# The compiler-tier workers below follow each repository's build files
# (scip_producer names one instead); the TypeScript one installs dependencies
# inside the persistent code checkout.
# C/C++ compiler indexing needs a project compilation database and scip-clang;
# these are repository build prerequisites, not additional running services.
# LOOM_CODE_REPOS_JSON=[{"org":"dev","namespace":"code-myrepo","repo":"acme/myrepo","git_branch":"main","public":true}]
LOOM_CODE_INGEST_ENABLED=true
LOOM_CODE_EMBED_RECOVERY_ENABLED=true
LOOM_CODE_GRAPH_STATS_ENABLED=true
LOOM_CODE_SCIP_DELTA_ENABLED=true
LOOM_CODE_SCIP_TS_DELTA_ENABLED=true
LOOM_CODE_SCIP_PY_DELTA_ENABLED=true
LOOM_CODE_SCIP_GO_DELTA_ENABLED=true
LOOM_MCP_CODE_TOOLS=true

# Example real-provider block (replace the active fake settings above):
# LOOM_EMBEDDING_MODEL=text-embedding-3-large
# LOOM_EMBEDDING_DIM=3072
# LOOM_LLM_PROVIDER=openai
# LOOM_LLM_MODEL=gpt-6-luna
# OPENAI_API_KEY=sk-...
# For one LLM provider, also inherit the chosen model for advanced jobs:
# LOOM_MEMORY_EXTRACT_VERIFY_MODELS=${LOOM_LLM_MODEL}
# LOOM_SESSION_BRIEF_LLM_MODEL=
# LOOM_CODE_BISECT_LLM_RERANK_MODEL=
# LOOM_TRACKER_DUPCHECK_RERANK_MODEL=
# LOOM_RETRIEVAL_JUDGE_MODEL=
# Then run: docker compose --project-directory "$HOME/.loom" up -d --force-recreate loom
