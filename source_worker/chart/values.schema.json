{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled"],
  "properties": {
    "enabled": {"type": "boolean"},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker", "proxy"],
      "properties": {
        "worker": {"$ref": "#/definitions/digestImage"},
        "proxy": {"$ref": "#/definitions/digestImage"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerConfigMap", "vaultTokenSecret", "proxyTlsSecret"],
      "properties": {
        "workerConfigMap": {"$ref": "#/definitions/objectName"},
        "vaultTokenSecret": {"$ref": "#/definitions/objectName"},
        "proxyTlsSecret": {"$ref": "#/definitions/objectName"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callers", "dns"],
      "properties": {
        "callers": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/definitions/podPeer"}
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nameservers"],
          "properties": {
            "nameservers": {
              "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
              "items": {"anyOf": [{"format": "ipv4", "type": "string"}, {"format": "ipv6", "type": "string"}]}
            },
            "pods": {"type": "array", "maxItems": 16, "items": {"$ref": "#/definitions/podPeer"}}
          }
        },
        "httpsPods": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/definitions/httpsPodPeer"}
        },
        "httpsCidrs": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr", "port"],
            "properties": {
              "cidr": {"type": "string", "pattern": "^[0-9A-Fa-f:.]+/[1-9][0-9]{0,2}$", "maxLength": 43},
              "port": {"$ref": "#/definitions/port"}
            }
          }
        }
      },
      "anyOf": [
        {"required": ["httpsPods"], "properties": {"httpsPods": {"minItems": 1}}},
        {"required": ["httpsCidrs"], "properties": {"httpsCidrs": {"minItems": 1}}}
      ]
    }
  },
  "if": {"properties": {"enabled": {"const": true}}},
  "then": {"required": ["images", "inputs", "network"]},
  "definitions": {
    "digestImage": {
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9._-]*(:[0-9]+)?/)*[a-z0-9][a-z0-9._-]*(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$"
    },
    "objectName": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "namespace": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "matchLabels": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": {"pattern": "^([a-z0-9][-.a-z0-9]*[a-z0-9]/|[a-z0-9]/)?[A-Za-z0-9]([-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9]([-_.A-Za-z0-9]{0,61}[A-Za-z0-9])?$"}
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "podPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "matchLabels"],
      "properties": {
        "namespace": {"$ref": "#/definitions/namespace"},
        "matchLabels": {"$ref": "#/definitions/matchLabels"}
      }
    },
    "httpsPodPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "matchLabels", "port"],
      "properties": {
        "namespace": {"$ref": "#/definitions/namespace"},
        "matchLabels": {"$ref": "#/definitions/matchLabels"},
        "port": {"$ref": "#/definitions/port"}
      }
    }
  }
}
