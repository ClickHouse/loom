# ============================================================
# Secrets — never commit. The .env file carries CH/Langfuse/OpenAI
# credentials and Loom's JWT signing keys.
# ============================================================
.env
.env.local
.env.*.local
# Timestamped .env backups written by hand and by redeploy.sh. The three
# patterns above do NOT match `.env.bak.<label>`, so five of these were tracked
# — each carrying a live ClickHouse password, JWT signing secret, OpenAI key and
# Langfuse token. A backup of a secrets file is a secrets file.
.env.bak*
.env.backup*
*.pem
*.key
secrets.json

