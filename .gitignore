# ============================================================
# Local-only working notes — design rationale lives in PR descriptions,
# not in the tree. Bench/eval scratch dumps stay out of git too.
# ============================================================
docs/design/
.eval/
*.draft.md

# Local operator artefacts: code mirrors and checkouts, vector backups.
var/

# Third-party agent skills installed via `npx skills add`. They carry
# executable instructions that run with full agent permissions, and this
# is a public repo — keep other people's skill code out of it. Loom's own
# development skills are tracked by name (Loom's published `loom-code` skill,
# which `npx skills add` installs here too, stays out), and Codex reads them
# through one tracked symlink each under `.agents/skills/`.
.claude/skills/*
.agents/skills/*
!.claude/skills/loom-address-review/
!.agents/skills/loom-address-review
!.claude/skills/loom-bench/
!.agents/skills/loom-bench
!.claude/skills/loom-change/
!.agents/skills/loom-change
!.claude/skills/loom-debug/
!.agents/skills/loom-debug
!.claude/skills/loom-deploy/
!.agents/skills/loom-deploy
!.claude/skills/loom-dev-setup/
!.agents/skills/loom-dev-setup
!.claude/skills/loom-file-issue/
!.agents/skills/loom-file-issue
!.claude/skills/loom-investigate-ci/
!.agents/skills/loom-investigate-ci
!.claude/skills/loom-pre-push/
!.agents/skills/loom-pre-push
!.claude/skills/loom-review/
!.agents/skills/loom-review
!.claude/skills/loom-ship-pr/
!.agents/skills/loom-ship-pr
!.claude/skills/loom-writing/
!.agents/skills/loom-writing
# `npx skills add` also drops a stray `agent/` copy and a lockfile.
agent/
skills-lock.json

# runtime data (mirrors, scip checkouts); iso launchers symlink it in
/var

# Per-user Claude Code state: agent worktrees and local permission overrides.
.claude/worktrees/
.claude/settings.local.json

# scripts/release/prepare.py's notes, pasted into the release pull request.
/release-notes.md
