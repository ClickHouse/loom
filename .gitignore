# ============================================================
# Runtime / operational
# ============================================================
# Local backups produced by dev/backup_loom.py
backups/
# Loom log directory if anyone redirects systemd output to a file
logs/
*.log
# Local sqlite caches (none today, but cheap to ignore)
*.sqlite
*.sqlite3
*.db
# JWT key material if anyone exports it to a file (canonical lives in .env)
jwt-*.pem
loom-jwt*
# Sigstore / cosign artifacts
*.sig
*.pub.asc

# ============================================================
# Generated artifacts
# ============================================================
sdk/python/loom.egg-info/
# OpenAPI export from `make openapi` if anyone runs it
openapi.yaml
openapi.json

# ============================================================
# Personal scratch files — anyone can name a file `scratch.*` or
# put it in `tmp/` and it stays local.
# ============================================================
scratch.*
tmp/
.tmp/
sdk/ts/node_modules/
sdk/ts/dist/
sdk/ts/*.log

# Bench outputs — keep the harness in repo but not the per-run dumps.
bench/out/
bench/*.csv
bench/lme_*.csv
bench/longmemeval_*.csv
bench/longmemeval_*.json
# Third-party scripts fetched for cross-checks (live in the LongMemEval repo).
bench/official/
deploy/clickhouse-config/named_collections.xml

# ============================================================
# Local-only working notes — design rationale lives in PR descriptions,
# not in the tree. Bench/eval scratch dumps stay out of git too.
# ============================================================
docs/design/
.eval/
*.draft.md

# Local operator artefacts: blob store, pre-migration vector backups.
var/

# Third-party agent skills installed via `npx skills add`. They carry
# executable instructions that run with full agent permissions, and this
# is a public repo — keep other people's skill code out of it. Loom's own
# development skills are named loom-* and tracked; `.agents/skills` is a
# tracked symlink to `.claude/skills`, so Codex reads the same files.
.claude/skills/*
!.claude/skills/loom-*/
# `npx skills add` also drops a stray `agent/` copy and a lockfile.
agent/
skills-lock.json

# runtime data (mirrors, scip checkouts); iso launchers symlink it in
/var

# Per-user Claude Code state: agent worktrees and local permission overrides.
.claude/worktrees/
.claude/settings.local.json
