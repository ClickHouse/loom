---
import { Badge } from "@clickhouse/click-ui/Badge";
import { BigStat } from "@clickhouse/click-ui/BigStat";
import { Icon } from "@clickhouse/click-ui/Icon";
import { ProgressBar } from "@clickhouse/click-ui/ProgressBar";
import { Link } from "@clickhouse/click-ui/Link";
import { Panel } from "@clickhouse/click-ui/Panel";
import { Table } from "@clickhouse/click-ui/Table";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import AdoptionActivity from "../components/AdoptionActivity.astro";
import AdoptionFilterForm from "../components/AdoptionFilterForm.astro";
import AdoptionLifecycle from "../components/AdoptionLifecycle.astro";
import AdoptionTrend from "../components/AdoptionTrend.astro";
import SiteFrame from "../components/SiteFrame.astro";
import { loadPublishedAdoption } from "../lib/adoption-data.mjs";
import {
  activityForRange,
  adoptionCsv,
  adoptionFilters,
  adoptionUrl,
  csvBody,
  daysBefore,
  grains,
  ranges,
  relativeChange,
  summarizeOss,
  thresholds,
} from "../lib/adoption-view.mjs";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
Astro.response.headers.set("Vercel-CDN-Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");

const filters = adoptionFilters(Astro.url.searchParams);
const dataset = Astro.url.searchParams.get("csv");
const tab = dataset ? (dataset === "downloads" || dataset === "stars" ? "oss" : "self-hosted") : filters.tab;
const { today, archivedStars, selfHosted, openSource } = await loadPublishedAdoption(tab);
const { totals: summaries, retention, versions, activity, lifecycle, domains } = selfHosted;
const totals = summaries?.find(({ range_days, comparison }) => range_days === filters.days && comparison === "current");
const previous = summaries?.find(
  ({ range_days, comparison }) => range_days === filters.days && comparison === "previous",
);
const compare = totals?.days_reported === filters.days && previous?.days_reported === filters.days;
const cutoff = daysBefore(today, filters.days);
const lastCompleteDate = daysBefore(today, 1);
const number = new Intl.NumberFormat("en-US");
const percent = new Intl.NumberFormat("en-US", { style: "percent", maximumFractionDigits: 1 });
const signed = new Intl.NumberFormat("en-US", { signDisplay: "exceptZero" });
const signedPercent = new Intl.NumberFormat("en-US", {
  style: "percent",
  maximumFractionDigits: 1,
  signDisplay: "exceptZero",
});
const series = activityForRange(activity, filters, today);
const lifecycleGroups = [
  { entity: "deployment", threshold: filters.installation, title: "Installation lifecycle" },
  { entity: "domain", threshold: filters.domain, title: "Domain lifecycle" },
].map((group) => ({
  ...group,
  rows: lifecycle.filter(
    (row) =>
      row.entity === group.entity &&
      row.min_requests === group.threshold &&
      row.grain === filters.cohort &&
      row.bucket >= cutoff,
  ),
}));
const oss = summarizeOss(openSource, filters.days, today);
const stars = oss.find(({ id }) => id === "stars");
const packageUrls = {
  PyPI: "https://pypi.org/project/clickhouse-loom/",
  npm: "https://www.npmjs.com/package/@clickhouse/loom",
};
if (dataset) {
  const rows = adoptionCsv(dataset, series, lifecycleGroups, oss);
  if (!rows) return new Response("Unknown dataset", { status: 404 });
  return new Response(csvBody(rows), {
    headers: {
      "Content-Type": "text/csv; charset=utf-8",
      "Content-Disposition": `attachment; filename="loom-${dataset}.csv"`,
      "Cache-Control": "public, max-age=300",
    },
  });
}
const metricGroups = [
  {
    title: "Successful requests by feature",
    entries: [
      ["Memory", "memory_requests"],
      ["Code", "code_requests"],
      ["Knowledge", "knowledge_requests"],
      ["Conversations", "conversation_requests"],
      ["Tracker", "tracker_requests"],
      ["Tasks", "task_requests"],
    ],
  },
  {
    title: "Successful requests by transport",
    entries: [
      ["MCP", "mcp_requests"],
      ["HTTP", "http_requests"],
    ],
  },
  {
    title: "Model usage",
    entries: [
      ["LLM calls", "llm_calls"],
      ["Input tokens", "input_tokens"],
      ["Output tokens", "output_tokens"],
      ["Embedding tokens", "embedding_tokens"],
    ],
  },
  {
    title: "Activity per installation",
    description:
      "Median daily peak among active installations. Each day uses the larger count from its two reporting windows.",
    entries: [
      ["Namespaces", "median_namespaces"],
      ["Agents", "median_agents"],
      ["Sessions", "median_sessions"],
    ],
  },
];
const overview = [
  ["Active installations", "active", "Ran at least one successful request"],
  ["Successful requests", "operations", "Across reporting installations"],
  ["Verified companies", "verified_companies", "Enrolled companies with an active installation"],
];
const date = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const shortDate = (day: string) => date.format(Date.parse(day));
const windowLabel = date.formatRange(new Date(cutoff), new Date(lastCompleteDate)) + " UTC";
const thresholdsLabel = (threshold: number) =>
  threshold ? thresholds[threshold] + " successful requests" : thresholds[threshold];
const labeledOptions = (labels: Record<string, string>) =>
  Object.entries(labels).map(([value, label]) => ({ value, label }));
const choiceFields = [
  { name: "grain", label: "Activity resolution", value: filters.grain, options: labeledOptions(grains) },
  {
    name: "cohort",
    label: "Lifecycle resolution",
    value: filters.cohort,
    options: labeledOptions({ week: "Weekly", month: "Monthly" }),
  },
  {
    name: "installation",
    label: "Installation threshold",
    value: filters.installation,
    options: labeledOptions(thresholds),
  },
  { name: "domain", label: "Domain threshold", value: filters.domain, options: labeledOptions(thresholds) },
];
const defaultFilters = adoptionFilters(new URLSearchParams());
const advanced = choiceFields.some(({ name, value }) => value !== defaultFilters[name]);
const hasLifecycle = lifecycleGroups.some(({ rows }) => rows.length > 0);
const metricValue = (value: number | null | undefined) => (value == null ? "—" : number.format(value));
const featureRequests = metricGroups[0].entries
  .map(([label, key]) => ({ label, value: totals?.[key] }))
  .filter(({ value }) => Number.isFinite(value))
  .sort((left, right) => right.value - left.value);
const featureMax = featureRequests.at(0)?.value ?? 0;
const ossHighlights = ["stars", "pypi", "npm"].flatMap((id) => oss.filter((metric) => metric.id === id));
const hasDownloads = oss.some(({ isDownload, history }) => isDownload && history.length);
---

<SiteFrame
  title="Loom Adoption | ClickHouse Loom"
  description="Reported self-hosted usage and open-source activity for ClickHouse Loom."
  path="/adoption"
>
  <div class="adoption">
    <header class="intro">
      <div>
        <Title type="h1" size="xl" family="brand">Loom adoption</Title>
        <Text className="intro-copy" size="lg" color="muted">See how teams run Loom and how developers use its open-source packages.</Text>
      </div>
      <Link href="#methodology">How we measure adoption</Link>
    </header>

    <div class="controls">
      <nav class="switcher" aria-label="Adoption views">
        <Link href={adoptionUrl(filters, { tab: "self-hosted" })} aria-current={filters.tab === "self-hosted" ? "page" : undefined}>Self-hosted</Link>
        <Link href={adoptionUrl(filters, { tab: "oss" })} aria-current={filters.tab === "oss" ? "page" : undefined}>Open source</Link>
      </nav>
      <nav class="ranges" aria-label="Reporting window">
        {ranges.map((days) => (
          <Link
            aria-current={filters.days === days ? "page" : undefined}
            aria-label={"Last " + days + " days"}
            href={adoptionUrl(filters, { days })}
            size="sm"
          >{days === 365 ? "1 year" : days + " days"}</Link>
        ))}
      </nav>
    </div>

    {filters.tab === "self-hosted" && <section id="self-hosted" aria-labelledby="self-hosted-title">
      <div class="section-heading">
        <div>
          <Title type="h2" size="lg" id="self-hosted-title">Self-hosted usage</Title>
          <Text size="sm" color="muted">{windowLabel}</Text>
        </div>
        <Link size="sm" href="#reported-contact-domains">Reported contact domains</Link>
      </div>
      {totals ? <>
        {totals.operations > 0 && <div class="metrics">
          {overview.map(([label, key, description]) => {
            const change = compare ? relativeChange(totals[key], previous[key]) : null;
            return <Panel className="metric" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
              <BigStat className="statistic" height="auto" label={label} title={metricValue(totals[key])} order="titleBottom" size="lg" />
              <Text color="muted" size="sm">{description}</Text>
              {change !== null && <Text className="change" size="sm">{signedPercent.format(change)} vs. previous {filters.days} days</Text>}
            </Panel>;
          })}
        </div>}
        <div class="coverage">
          <div>
            <Text className="coverage-title" size="sm" weight="semibold">{totals.days_reported} of {filters.days} days reported</Text>
            <Text size="sm" color="muted">{number.format(totals.reporting)} installations sent telemetry. Latest reporting date <time datetime={totals.last_reported}>{shortDate(totals.last_reported)}</time> UTC.</Text>
            {totals.operations === 0 && <Text size="sm" color="muted">No successful requests were reported in this window.</Text>}
          </div>
          <ProgressBar className="coverage-meter" type="small" progress={(totals.days_reported / filters.days) * 100} aria-hidden="true" />
        </div>
      </> : (
        <Panel className="coverage empty" padding="lg" hasBorder fillWidth>
          <Text size="sm" color="muted">{Array.isArray(summaries) ? "No installations reported in this window." : "Self-hosted telemetry is unavailable."}</Text>
        </Panel>
      )}

      <div class:list={["proof", { split: archivedStars }]}>
        <Panel className="proof-card" id="reported-contact-domains" orientation="vertical" alignItems="start" gap="xs" padding="lg" hasBorder fillWidth>
          <Title type="h3" size="md">Reported contact domains</Title>
          <Text size="sm" color="muted">Namespace contact domains shared by installations with a successful request in the last 90 complete UTC days.</Text>
          {domains === null ? (
            <Text className="empty-state" size="sm">The domain list is unavailable.</Text>
          ) : domains.length > 0 ? (
            <ul class="contact-domains">
              {domains.map((domain) => <li><Badge text={domain} size="md" state="neutral" /></li>)}
            </ul>
          ) : (
            <Text className="empty-state" size="sm">No domains met the reporting criteria.</Text>
          )}
        </Panel>
        {archivedStars && <Panel className="proof-card repository" orientation="vertical" alignItems="start" gap="xs" padding="lg" hasBorder fillWidth>
          <BigStat className="statistic" height="auto" label="GitHub stars" title={number.format(archivedStars.value)} order="titleBottom" size="lg" />
          <Text size="sm" color="muted">Snapshot from <time datetime={archivedStars.day}>{shortDate(archivedStars.day)}</time></Text>
          <Link className="text-link" size="sm" href={adoptionUrl(filters, { tab: "oss" })}>Explore open-source activity</Link>
        </Panel>}
      </div>
      {!archivedStars && <Link className="open-source-link" size="sm" href={adoptionUrl(filters, { tab: "oss" })}>Explore open-source activity</Link>}

      <section class="data-section" id="installation-activity" aria-labelledby="activity-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="activity-title">Usage over time</Title>
            <Text size="sm" color="muted">Observed activity in reporting installations for the selected window.</Text>
          </div>
          {series.length > 0 && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "activity" })}><Icon aria-hidden="true" name="download" size="sm" />Download activity CSV</Link>}
        </div>
        <AdoptionFilterForm fields={choiceFields} days={filters.days} active={advanced} />
        {series.length > 0 ? (
          <AdoptionActivity rows={series} grain={filters.grain} />
        ) : <Text size="sm" color="muted">No activity periods are available for this selection.</Text>}
      </section>

      <section class="data-section" id="lifecycle" aria-labelledby="lifecycle-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="lifecycle-title">New and returning activity</Title>
            <Text size="sm" color="muted">Compare first-time, retained, and reactivated activity across completed periods.</Text>
          </div>
          {hasLifecycle && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "lifecycle" })}><Icon aria-hidden="true" name="download" size="sm" />Download lifecycle CSV</Link>}
        </div>
        {hasLifecycle ? <div class="two-column">
          {lifecycleGroups.map(({ title, threshold, rows }) => (
            <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
              <Title type="h3" size="sm">{title}</Title>
              <Text size="sm" color="muted">{thresholdsLabel(threshold)} per {filters.cohort}</Text>
              <AdoptionLifecycle title={title} grain={filters.cohort} rows={rows} />
            </Panel>
          ))}
        </div> : <Text size="sm" color="muted">No completed periods with qualifying activity.</Text>}

        {retention?.length > 0 && <details class="detail">
          <summary>View weekly installation retention</summary>
          <Text size="sm" color="muted">Return activity after the first observed active week, across the last 13 complete UTC cohorts.</Text>
          <Table
            size="sm"
            aria-label="Weekly installation retention"
            mobileLayout="scroll"
            headers={[{ label: "Week" }, { label: "Active / eligible" }, { label: "Retained" }]}
            rows={retention.map(({ age, active, eligible }) => ({
              id: age,
              items: [{ label: age }, { label: number.format(active) + " / " + number.format(eligible) }, { label: eligible > 0 ? percent.format(active / eligible) : "—" }],
            }))}
          />
        </details>}
      </section>

      {(totals?.reporting > 0 || versions?.length > 0) && <section class="data-section" aria-labelledby="breakdown-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="breakdown-title">What installations use</Title>
            <Text size="sm" color="muted">Successful requests across Loom features and transports.</Text>
          </div>
        </div>
        {featureMax > 0 && <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
          <Title type="h3" size="sm">Successful requests by feature</Title>
          <ul class="feature-bars">
            {featureRequests.map(({ label, value }) => (
              <li>
                <span>{label}</span><span class="bar-track" aria-hidden="true"><span style={"--value:" + (value / featureMax) * 100 + "%"}></span></span><strong>{number.format(value)}</strong>
              </li>
            ))}
          </ul>
        </Panel>}
        {totals?.reporting > 0 && <details class="detail">
          <summary>View request and model metrics</summary>
          <div class="two-column">
            {[
              ...metricGroups,
              {
                title: "Request outcomes",
                entries: [["Total requests", "requests"], ["Successful requests", "operations"], ["Server errors", "server_errors"]],
              },
            ].map(({ title, description, entries }) => (
              <Panel className="table-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
                <Title type="h3" size="sm">{title}</Title>
                {description && <Text size="sm" color="muted">{description}</Text>}
                <Table
                  size="sm"
                  aria-label={title}
                  headers={[{ label: "Metric" }, { label: "Value" }]}
                  rows={entries.map(([label, key]) => ({ id: key, items: [{ label }, { label: metricValue(totals[key]) }] }))}
                />
              </Panel>
            ))}
          </div>
        </details>}
        {versions?.length > 0 && <details class="detail">
          <summary>View reported software versions</summary>
          <Text size="sm" color="muted">Versions from installations that sent telemetry in the last 30 complete UTC days.</Text>
          <Table
            size="sm"
            aria-label="Reported software versions"
            mobileLayout="scroll"
            headers={[{ label: "Loom" }, { label: "ClickHouse" }, { label: "Reporting installations" }]}
            rows={versions.map((row) => ({
              id: row.loom_version + "/" + row.clickhouse_version,
              items: [{ label: row.loom_version }, { label: row.clickhouse_version }, { label: number.format(row.installations) }],
            }))}
          />
        </details>}
      </section>}
    </section>}

    {filters.tab === "oss" && <section id="oss" aria-labelledby="oss-title">
      <div class="section-heading">
        <div>
          <Title type="h2" size="lg" id="oss-title">Open-source activity</Title>
          <Text size="sm" color="muted">SDK downloads for {windowLabel}. GitHub stars reflect the latest available total.</Text>
        </div>
      </div>
      <div class="metrics">
        {ossHighlights.map(({ label, source, value, day, days, change, isDownload }) => (
          <Panel className="metric" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
            <BigStat className="statistic" height="auto" label={label} title={metricValue(value)} order="titleBottom" size="lg" />
            <Text size="sm" color="muted">
              {source} · {isDownload && days ? days + " of " + filters.days + " days reported" : day ? <time datetime={day}>{shortDate(day)}</time> : "Data unavailable"}
            </Text>
            {change !== null && <Text className="change" size="sm">{isDownload ? signedPercent.format(change) + " vs. previous " + filters.days + " days" : signed.format(change) + " since " + shortDate(cutoff)}</Text>}
          </Panel>
        ))}
      </div>

      <section class="data-section" id="downloads" aria-labelledby="downloads-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="downloads-title">SDK downloads</Title>
            <Text size="sm" color="muted">Compare daily or monthly downloads from reporting package registries.</Text>
          </div>
          {hasDownloads && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "downloads" })}><Icon aria-hidden="true" name="download" size="sm" />Download SDK CSV</Link>}
        </div>
        <div class="two-column">
          {oss.filter(({ isDownload }) => isDownload).map(({ label, source, monthly, history }) => {
            const useDaily = monthly.length < 3 && history.length >= 3;
            return <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
              <Title type="h3" size="sm">{label}</Title>
              <Link href={packageUrls[source]} size="sm">View package on {source}</Link>
              {monthly.length > 0 ? <>
                <Text size="sm" color="muted">{useDaily ? "Reported downloads by day" : "Reported downloads by month"}</Text>
                <AdoptionTrend label={label} grain={useDaily ? "day" : "month"} rows={useDaily ? history : monthly} />
                <details class="detail download-detail">
                  <summary>{useDaily ? "View monthly totals" : "View daily download history"}</summary>
                  {useDaily ? <Table
                    size="sm"
                    aria-label={label + " by month"}
                    mobileLayout="scroll"
                    headers={[{ label: "UTC month" }, { label: "Downloads" }, { label: "Days reported" }]}
                    rows={monthly.map(({ day, value, days }) => ({
                      id: day,
                      items: [{ label: day.slice(0, 7) }, { label: number.format(value) }, { label: days }],
                    }))}
                  /> : <AdoptionTrend label={label} rows={history} />}
                </details>
              </> : <Text size="sm" color="muted">Data unavailable.</Text>}
            </Panel>;
          })}
        </div>
      </section>

      <section class="data-section" id="github-stars" aria-labelledby="github-stars-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="github-stars-title">Repository interest</Title>
            <Text size="sm" color="muted">Cumulative GitHub stars from daily snapshots.</Text>
          </div>
          {stars?.history.length > 0 && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "stars" })}><Icon aria-hidden="true" name="download" size="sm" />Download stars CSV</Link>}
        </div>
        <div class="two-column">
          <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
            <Title type="h3" size="sm">GitHub stars over time</Title>
            {stars?.history.length > 0 ? <AdoptionTrend label="GitHub stars" rows={stars.history} mode="line" /> : <Text size="sm" color="muted">Daily snapshots appear as they are collected.</Text>}
          </Panel>
          <Panel className="table-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
            <Title type="h3" size="sm">Project and distribution totals</Title>
            <Table
              size="sm"
              aria-label="Project and distribution totals"
              mobileLayout="scroll"
              headers={[{ label: "Metric" }, { label: "Total" }, { label: "Snapshot (UTC)" }]}
              rows={oss.filter(({ isDownload }) => !isDownload).map(({ id, label, value, day }) => ({
                id,
                items: [{ label }, { label: metricValue(value) }, { label: day ? shortDate(day) : "—" }],
              }))}
            />
          </Panel>
        </div>
      </section>
    </section>}

    <section id="methodology" class="data-section" aria-labelledby="methodology-title">
      <div class="section-heading"><Title type="h2" size="lg" id="methodology-title">How we measure adoption</Title></div>
      <dl class="methodology">
        <div>
          <dt>Self-hosted usage</dt>
          <dd>Coverage depends on which installations report. An installation counts once per period. An active installation recorded a successful request.</dd>
        </div>
        <div>
          <dt>Reported organizations</dt>
          <dd>Verified companies enroll separately. A namespace contact domain is self-reported.</dd>
        </div>
        <div>
          <dt>Open-source activity</dt>
          <dd>GitHub counters reflect cumulative repository activity. Package downloads can include automated builds and retries.</dd>
        </div>
        <div>
          <dt>Comparison and projection</dt>
          <dd>Relative changes use two fully reported windows. A request projection uses the daily average when each elapsed day in the period has data.</dd>
        </div>
      </dl>
      <Link href="/telemetry" size="sm">Telemetry settings and privacy</Link>
    </section>
    <Panel className="next-step" padding="lg" gap="sm" hasBorder fillWidth>
      <div>
        <Title type="h2" size="md">Run Loom</Title>
        <Text size="sm" color="muted">Start a self-hosted installation and connect your first agent.</Text>
      </div>
      <Link className="primary" href="/docs/getting-started/quickstart">Install Loom</Link>
    </Panel>
  </div>
</SiteFrame>

<style>
  :global(#content):has(> .adoption) { padding-block-start: clamp(1.75rem, 4vw, 3.5rem); }
  .adoption [id] { scroll-margin-block-start: 4.5rem; }
  .intro, .section-heading, .controls, .coverage, .next-step {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
  }
  .intro h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .intro-copy { margin-block-start: 0.65rem; }
  .intro a, .section-heading a { min-block-size: 2.5rem; display: inline-flex; align-items: center; }
  .controls {
    margin-block: clamp(1.4rem, 3vw, 2.2rem) 1.35rem;
    border-block-end: 1px solid var(--line);
  }
  .switcher, .ranges { display: flex; align-items: center; flex-wrap: wrap; gap: 0.32rem; }
  .switcher a, .ranges a {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
  }
  .switcher a { padding-inline: 0.78rem; border-block-end: 2px solid transparent; }
  .switcher a:hover, .switcher a[aria-current], .ranges a:hover, .ranges a[aria-current] {
    color: var(--click-global-color-text-default);
  }
  .switcher a[aria-current] { border-color: var(--accent); }
  .ranges { margin-block-end: 0.45rem; }
  .ranges a {
    padding-inline: 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: 0.86rem;
  }
  .ranges a[aria-current] {
    background: var(--surface-raised);
    border-color: var(--line);
  }
  .section-heading { margin-block-end: 0.9rem; }
  .section-heading h2 { font-size: clamp(1.5rem, 2.5vw, 2.15rem); }
  .section-heading p { margin-block-start: 0.3rem; }
  .metrics, .proof, .two-column { display: grid; gap: 0.85rem; }
  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .two-column { grid-template-columns: repeat(2, minmax(0, 1fr)); }
