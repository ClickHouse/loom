---
import { BigStat } from "@clickhouse/click-ui/BigStat";
import { Icon } from "@clickhouse/click-ui/Icon";
import { Link } from "@clickhouse/click-ui/Link";
import { Panel } from "@clickhouse/click-ui/Panel";
import { ProgressBar } from "@clickhouse/click-ui/ProgressBar";
import { Table } from "@clickhouse/click-ui/Table";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import AdoptionActivity from "../components/AdoptionActivity.astro";
import AdoptionDomainDirectory from "../components/AdoptionDomainDirectory.astro";
import AdoptionFilterForm from "../components/AdoptionFilterForm.astro";
import AdoptionGrowth from "../components/AdoptionGrowth.astro";
import AdoptionLifecycle from "../components/AdoptionLifecycle.astro";
import AdoptionTrend from "../components/AdoptionTrend.astro";
import AdoptionUsageTrends from "../components/AdoptionUsageTrends.astro";
import SiteFrame from "../components/SiteFrame.astro";
import { loadPublishedAdoption } from "../lib/adoption-data.mjs";
import {
  activityForRange,
  adoptionCsv,
  adoptionFilters,
  adoptionGrowthForRange,
  adoptionUrl,
  csvBody,
  daysBefore,
  grains,
  ranges,
  relativeChange,
  summarizeOss,
  thresholds,
} from "../lib/adoption-view.mjs";
import { repositoryUrl } from "../lib/site-identity.mjs";

export const prerender = false;

const filters = adoptionFilters(Astro.url.searchParams);
const dataset = Astro.url.searchParams.get("csv");
const tab = dataset ? (dataset === "downloads" || dataset === "stars" ? "oss" : "self-hosted") : filters.tab;
const { today, selfHosted, openSource } = await loadPublishedAdoption(tab);
const { totals: summaries, retention, versions, activity, lifecycle } = selfHosted;
const warehouseAvailable = Array.isArray(summaries);
if (warehouseAvailable) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
  Astro.response.headers.set(
    "Vercel-CDN-Cache-Control",
    tab === "self-hosted"
      ? "public, s-maxage=60, stale-while-revalidate=60"
      : "public, s-maxage=3600, stale-while-revalidate=86400",
  );
} else {
  Astro.response.headers.set("Cache-Control", "no-store");
}
const totals = summaries?.find(({ range_days, comparison }) => range_days === filters.days && comparison === "current");
const currentComplete = summaries?.find(
  ({ range_days, comparison }) => range_days === filters.days && comparison === "current_complete",
);
const previousComplete = summaries?.find(
  ({ range_days, comparison }) => range_days === filters.days && comparison === "previous_complete",
);
const compare = currentComplete?.days_reported === filters.days && previousComplete?.days_reported === filters.days;
const cutoff = daysBefore(today, filters.days);
const lastCompleteDate = daysBefore(today, 1);
const number = new Intl.NumberFormat("en-US");
const percent = new Intl.NumberFormat("en-US", { style: "percent", maximumFractionDigits: 1 });
const signed = new Intl.NumberFormat("en-US", { signDisplay: "exceptZero" });
const signedPercent = new Intl.NumberFormat("en-US", {
  style: "percent",
  maximumFractionDigits: 1,
  signDisplay: "exceptZero",
});
const series = activityForRange(activity, filters, today);
const growthSeries = adoptionGrowthForRange(selfHosted.growth, filters, today);
const latestGrowth = selfHosted.growth?.findLast(({ grain }) => grain === "day");
const growthCoverage = selfHosted.growthCoverage;
const directoryDays = Math.min(filters.days, 90);
const lifecycleGroups = [
  { entity: "deployment", threshold: filters.installation, title: "Installation lifecycle" },
  { entity: "domain", threshold: filters.domain, title: "Domain lifecycle" },
].map((group) => ({
  ...group,
  rows: lifecycle.filter(
    (row) =>
      row.entity === group.entity &&
      row.min_requests === group.threshold &&
      row.grain === filters.cohort &&
      row.bucket >= cutoff,
  ),
}));
const oss = summarizeOss(openSource, filters.days, today);
const stars = oss.find(({ id }) => id === "stars");
if (dataset) {
  const rows = adoptionCsv(dataset, series, lifecycleGroups, oss);
  if (!rows) return new Response("Unknown dataset", { status: 404 });
  return new Response(csvBody(rows), {
    headers: {
      "Content-Type": "text/csv; charset=utf-8",
      "Content-Disposition": `attachment; filename="loom-${dataset}.csv"`,
      "Cache-Control": !warehouseAvailable
        ? "no-store"
        : tab === "self-hosted"
          ? "public, max-age=60"
          : "public, max-age=300",
    },
  });
}
const metricGroups = [
  {
    title: "Successful requests by feature",
    entries: [
      ["Memory", "memory_requests"],
      ["Code", "code_requests"],
      ["Knowledge", "knowledge_requests"],
      ["Conversations", "conversation_requests"],
      ["Tracker", "tracker_requests"],
      ["Tasks", "task_requests"],
    ],
  },
  {
    title: "Successful requests by transport",
    entries: [
      ["MCP", "mcp_requests"],
      ["HTTP", "http_requests"],
    ],
  },
  {
    title: "Model usage",
    entries: [
      ["LLM calls", "llm_calls"],
      ["Input tokens", "input_tokens"],
      ["Output tokens", "output_tokens"],
      ["Embedding tokens", "embedding_tokens"],
    ],
  },
  {
    title: "Activity per installation",
    description:
      "Median daily peak among active installations. Each day uses the larger count from its two reporting windows.",
    entries: [
      ["Namespaces", "median_namespaces"],
      ["Agents", "median_agents"],
      ["Sessions", "median_sessions"],
    ],
  },
];
const overview = [
  ["Active installations", "active", "Ran at least one successful request"],
  ["Reporting installations", "reporting", "Sent telemetry in the selected window"],
  ["Successful requests", "operations", "Across reporting installations"],
  ["Verified companies", "verified_companies", "Enrolled companies with an active installation"],
];
const date = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const shortDate = (day: string) => date.format(Date.parse(day));
const windowLabel = date.formatRange(new Date(cutoff), new Date(lastCompleteDate)) + " UTC";
const selfHostedWindowLabel =
  date.formatRange(new Date(cutoff), new Date(totals?.last_reported === today ? today : lastCompleteDate)) + " UTC";
const thresholdsLabel = (threshold: number) =>
  threshold ? thresholds[threshold] + " successful requests" : thresholds[threshold];
const labeledOptions = (labels: Record<string, string>) =>
  Object.entries(labels).map(([value, label]) => ({ value, label }));
const thresholdChoices = labeledOptions({ 0: "Any success", 50000: "Over 50k", 1000000: "Over 1M" });
const choiceFields = [
  { name: "grain", label: "Activity interval", value: filters.grain, options: labeledOptions(grains) },
  {
    name: "cohort",
    label: "Lifecycle interval",
    value: filters.cohort,
    options: labeledOptions({ week: "Weekly", month: "Monthly" }),
  },
  {
    name: "installation",
    label: "Installation threshold",
    value: filters.installation,
    options: thresholdChoices,
  },
  { name: "domain", label: "Domain threshold", value: filters.domain, options: thresholdChoices },
];
const hasLifecycle = lifecycleGroups.some(({ rows }) => rows.length > 0);
const metricValue = (value: number | null | undefined) => (value == null ? "—" : number.format(value));
const featureRequests = metricGroups[0].entries
  .map(([label, key]) => ({ label, value: totals?.[key] }))
  .filter(({ value }) => Number.isFinite(value))
  .sort((left, right) => right.value - left.value);
const featureMax = featureRequests.at(0)?.value ?? 0;
const hasFeatureTrends = series.some((row) => metricGroups[0].entries.some(([, key]) => Number.isFinite(row[key])));
const ossGrain = filters.days === 30 ? "day" : "month";
const ossInterval = (day: string) => (ossGrain === "day" ? day : day.slice(0, 7) + "-01");
const daysInMonth = (day: string) =>
  new Date(Date.UTC(Number(day.slice(0, 4)), Number(day.slice(5, 7)), 0)).getUTCDate();
const sdkDownloads = oss
  .filter(({ sdkName, isDownload }) => sdkName && isDownload)
  .map((metric) => ({
    ...metric,
    rows:
      ossGrain === "day"
        ? metric.history
        : metric.monthly.map((row) => ({ ...row, partial: row.days < daysInMonth(row.day) })),
  }));
const sdkMaximum = Math.max(1, ...sdkDownloads.flatMap(({ rows }) => rows.map(({ value }) => value)));
const hasDownloads = sdkDownloads.some(({ rows }) => rows.length > 0);
const counterMetrics = oss
  .filter(({ isDownload }) => !isDownload)
  .map((metric) => ({
    ...metric,
    rows:
      ossGrain === "day"
        ? metric.history
        : Array.from(new Map(metric.history.map(({ day, value }) => [ossInterval(day), value])), ([day, value]) => ({
            day,
            value,
          })),
  }));
const moreSdks = [
  ["Go SDK", "/docs/reference/go-sdk"],
  ["Ruby source", `${repositoryUrl}/tree/main/sdk/ruby`],
  [".NET source", `${repositoryUrl}/tree/main/sdk/dotnet`],
  ["Java source", `${repositoryUrl}/tree/main/sdk/java`],
];
const ossCounterGroups = [
  {
    id: "github-stars",
    title: "Repository interest",
    description: "Stars and forks from cumulative GitHub snapshots.",
    metrics: counterMetrics.filter(({ id }) => id === "stars" || id === "forks"),
  },
  {
    id: "release-distribution",
    title: "Release and container distribution",
    description: "Cumulative downloads of release assets and pulls from the GitHub Container Registry.",
    metrics: counterMetrics.filter(({ id }) => id === "releases" || id === "pulls"),
  },
];
---

<SiteFrame
  title="Loom Adoption | ClickHouse Loom"
  description="Reported self-hosted usage and open-source activity for ClickHouse Loom."
  path="/adoption"
>
  <div class="adoption">
    <header class="intro">
      <div>
        <Title type="h1" size="xl" family="brand">Loom adoption</Title>
        <Text className="intro-copy" size="lg" color="muted">{filters.tab === "self-hosted" ? "Follow self-hosted installation growth and how teams use Loom." : "Track SDK distribution and interest in the Loom repository."}</Text>
      </div>
      <Link href="#methodology">How we measure adoption</Link>
    </header>

    <div class="controls">
      <nav class="switcher" aria-label="Adoption views">
        <Link href={adoptionUrl(filters, { tab: "self-hosted" })} aria-current={filters.tab === "self-hosted" ? "page" : undefined}>Self-hosted</Link>
        <Link href={adoptionUrl(filters, { tab: "oss" })} aria-current={filters.tab === "oss" ? "page" : undefined}>Open source</Link>
      </nav>
      <nav class="ranges" aria-label="Reporting window">
        {ranges.map((days) => (
          <Link
            aria-current={filters.days === days ? "page" : undefined}
            aria-label={"Last " + days + " days"}
            href={adoptionUrl(filters, { days })}
            size="sm"
          >{days === 365 ? "1 year" : days + " days"}</Link>
        ))}
      </nav>
    </div>

    {filters.tab === "self-hosted" && <section id="self-hosted" aria-labelledby="self-hosted-title">
      <div class="section-heading">
        <div>
          <Title type="h2" size="lg" id="self-hosted-title">Self-hosted adoption</Title>
          <Text size="sm" color="muted">Growth and usage from self-hosted installations that report adoption telemetry.</Text>
        </div>
        <Link size="sm" href="#reported-contact-domains">Reported contact domains</Link>
      </div>
      {latestGrowth ? (
        <div class="growth-overview">
          <Panel className="growth-stat" orientation="vertical" alignItems="start" padding="lg" gap="sm" hasBorder fillWidth>
            <BigStat className="statistic" height="auto" label="Observed self-hosted installations" title={number.format(latestGrowth.cumulative_active)} order="titleBottom" size="lg" />
            <Text size="sm" color="muted">{growthCoverage
              ? "Retained telemetry from " + date.formatRange(new Date(growthCoverage.first_day), new Date(growthCoverage.last_day)) + " UTC"
              : "Across retained self-hosted telemetry"}</Text>
          </Panel>
          {growthSeries.length > 0 ? (
            <AdoptionGrowth rows={growthSeries} grain={filters.grain} rangeStart={cutoff} />
          ) : <Text className="growth-message" size="sm" color="muted">No growth periods are available in the selected window.</Text>}
        </div>
      ) : summaries && <Text size="sm" color="muted">
        {selfHosted.growth === null ? "Cumulative installation history is unavailable." : "No self-hosted installations have reported yet."}
      </Text>}
      <div class="chart-settings" id="installation-activity">
        <AdoptionFilterForm fields={choiceFields} days={filters.days} />
      </div>

      <section class="data-section" aria-labelledby="activity-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="activity-title">Installation activity</Title>
            <Text size="sm" color="muted">{selfHostedWindowLabel}</Text>
          </div>
          {series.length > 0 && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "activity" })}><Icon aria-hidden="true" name="download" size="sm" />Download activity CSV</Link>}
        </div>
        {totals ? <>
          <div class="metrics">
            {overview.map(([label, key, description]) => {
              const change = compare ? relativeChange(currentComplete[key], previousComplete[key]) : null;
              return <Panel className="metric" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
                <BigStat className="statistic" height="auto" label={label} title={metricValue(totals[key])} order="titleBottom" size="sm" />
                <Text color="muted" size="sm">{description}</Text>
                {change !== null && <Text className="change" size="sm">Complete days {signedPercent.format(change)} vs. previous {filters.days} days</Text>}
              </Panel>;
            })}
          </div>
          <div class="coverage">
            <div>
              <Text className="coverage-title" size="sm" weight="semibold">{totals.days_reported} of {filters.days} complete days reported</Text>
              <Text size="sm" color="muted">Latest reporting date <time datetime={totals.last_reported}>{shortDate(totals.last_reported)}</time> UTC.</Text>
              {totals.last_reported === today && <Text size="sm" color="muted">Totals include completed reporting windows today.</Text>}
            </div>
            <ProgressBar className="coverage-meter" type="small" progress={(totals.days_reported / filters.days) * 100} aria-hidden="true" />
          </div>
        </> : (
          <Panel className="coverage empty" padding="lg" hasBorder fillWidth>
            <Text size="sm" color="muted">{Array.isArray(summaries) ? "No installations reported in this window." : "Self-hosted telemetry is unavailable."}</Text>
          </Panel>
        )}
        {series.length > 0 ? (
          <div class="activity-charts">
            <AdoptionActivity rows={series} grain={filters.grain} />
          </div>
        ) : (
          totals && <Text className="activity-charts" size="sm" color="muted">No activity periods are available for this selection.</Text>
        )}
      </section>

      {(series.length > 0 || totals?.reporting > 0 || versions?.length > 0) && <section class="data-section" aria-labelledby="breakdown-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="breakdown-title">What installations use</Title>
            <Text size="sm" color="muted">Feature, transport, and model usage across reporting installations.</Text>
          </div>
        </div>
        {series.length > 0 && <AdoptionUsageTrends rows={series} grain={filters.grain} csvHref={adoptionUrl(filters, { csv: "usage" })} />}
        {!hasFeatureTrends && featureMax > 0 && <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
          <Title type="h3" size="sm">Feature requests in the selected window</Title>
          <ul class="feature-bars">
            {featureRequests.map(({ label, value }) => (
              <li>
                <span>{label}</span><span class="bar-track" aria-hidden="true"><span style={"--value:" + (value / featureMax) * 100 + "%"}></span></span><strong>{number.format(value)}</strong>
              </li>
            ))}
          </ul>
        </Panel>}
        {totals?.reporting > 0 && <details class="detail">
          <summary>View totals for the selected window</summary>
          <div class="two-column">
            {[
              ...metricGroups,
              {
                title: "Request outcomes",
                entries: [["Total requests", "requests"], ["Successful requests", "operations"], ["Server errors", "server_errors"]],
              },
            ].map(({ title, description, entries }) => (
              <Panel className="table-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
                <Title type="h3" size="sm">{title}</Title>
                {description && <Text size="sm" color="muted">{description}</Text>}
                <Table
                  size="sm"
                  aria-label={title}
                  headers={[{ label: "Metric" }, { label: "Value" }]}
                  rows={entries.map(([label, key]) => ({ id: key, items: [{ label }, { label: metricValue(totals[key]) }] }))}
                />
              </Panel>
            ))}
          </div>
        </details>}
        {versions?.length > 0 && <details class="detail">
          <summary>View reported software versions</summary>
          <Text size="sm" color="muted">Versions from installations that sent telemetry in the last 30 complete UTC days.</Text>
          <Table
            size="sm"
            aria-label="Reported software versions"
            mobileLayout="scroll"
            headers={[{ label: "Loom" }, { label: "ClickHouse" }, { label: "Reporting installations" }]}
            rows={versions.map((row) => ({
              id: row.loom_version + "/" + row.clickhouse_version,
              items: [{ label: row.loom_version }, { label: row.clickhouse_version }, { label: number.format(row.installations) }],
            }))}
          />
        </details>}
      </section>}

      <section class="data-section" id="lifecycle" aria-labelledby="lifecycle-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="lifecycle-title">New and returning activity</Title>
            <Text size="sm" color="muted">Compare first-time, retained, and reactivated activity across completed periods.</Text>
          </div>
          {hasLifecycle && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "lifecycle" })}><Icon aria-hidden="true" name="download" size="sm" />Download lifecycle CSV</Link>}
        </div>
        {hasLifecycle ? <div class="two-column">
          {lifecycleGroups.map(({ title, threshold, rows }) => (
            <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
              <Title type="h3" size="sm">{title}</Title>
              <Text size="sm" color="muted">{thresholdsLabel(threshold)} per {filters.cohort}</Text>
              <AdoptionLifecycle title={title} grain={filters.cohort} rows={rows} />
            </Panel>
          ))}
        </div> : <Text size="sm" color="muted">No completed periods with qualifying activity.</Text>}

        {retention?.length > 0 && <details class="detail">
          <summary>View weekly installation retention</summary>
          <Text size="sm" color="muted">Return activity after the first observed active week, across the last 13 complete UTC cohorts.</Text>
          <Table
            size="sm"
            aria-label="Weekly installation retention"
            mobileLayout="scroll"
            headers={[{ label: "Week" }, { label: "Active / eligible" }, { label: "Retained" }]}
            rows={retention.map(({ age, active, eligible }) => ({
              id: age,
              items: [{ label: age }, { label: number.format(active) + " / " + number.format(eligible) }, { label: eligible > 0 ? percent.format(active / eligible) : "—" }],
            }))}
          />
        </details>}
      </section>

      <AdoptionDomainDirectory
        domains={selfHosted.domains}
        rankedDomains={selfHosted.domainDirectories?.[directoryDays] ?? null}
        days={directoryDays}
        filterHref={adoptionUrl(filters, { tab: "self-hosted" })}
      />
    </section>}

    {filters.tab === "oss" && <div id="oss">
      <section id="downloads" aria-labelledby="downloads-title">
        <div class="section-heading">
          <div>
            <Title type="h2" size="lg" id="downloads-title">SDK distribution</Title>
            <Text size="sm" color="muted">{windowLabel} · {ossGrain === "day" ? "Daily downloads" : "Monthly downloads within the selected window"}</Text>
          </div>
          {hasDownloads && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "downloads" })}><Icon aria-hidden="true" name="download" size="sm" />Download SDK CSV</Link>}
        </div>
        <div class="sdk-downloads">
          {sdkDownloads.map(({ label, sdkName, packageUrl, source, rows, value, days, change }) => (
            <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
              <div class="card-heading">
                <Title type="h3" size="sm">{sdkName}</Title>
                <Link href={packageUrl} size="sm">View on {source}</Link>
              </div>
              {rows.length > 0 ? <>
                <BigStat className="statistic" height="auto" label="Downloads in this window" title={metricValue(value)} order="titleBottom" size="lg" />
                <Text size="sm" color="muted">{days} of {filters.days} days reported</Text>
                <AdoptionTrend
                  label={label}
                  grain={ossGrain}
                  rows={rows}
                  axisMaximum={sdkMaximum}
                  axisStart={ossInterval(cutoff)}
                  axisEnd={ossInterval(lastCompleteDate)}
                />
                {change !== null && <Text className="change" size="sm">{signedPercent.format(change)} vs. previous {filters.days} days</Text>}
              </> : <Text size="sm" color="muted">No download history is available for this window.</Text>}
            </Panel>
          ))}
        </div>
        <div class="more-sdks">
          <Text size="sm" weight="semibold">More SDKs</Text>
          <ul role="list">
            {moreSdks.map(([label, href]) => <li><Link href={href} size="sm">{label}</Link></li>)}
          </ul>
        </div>
      </section>

      {ossCounterGroups.map(({ id, title, description, metrics }) => (
        <section class="data-section" id={id} aria-labelledby={id + "-title"}>
          <div class="section-heading">
            <div>
              <Title type="h2" size="lg" id={id + "-title"}>{title}</Title>
              <Text size="sm" color="muted">{description} {ossGrain === "month" && "Charts use the last available snapshot in each month."}</Text>
            </div>
            {id === "github-stars" && stars?.history.length > 0 && <Link className="download-link" size="sm" href={adoptionUrl(filters, { csv: "stars" })}><Icon aria-hidden="true" name="download" size="sm" />Download stars CSV</Link>}
          </div>
          <div class="two-column">
            {metrics.map(({ label, value, day, change, rows }) => (
              <Panel className="chart-card" orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
                <Title type="h3" size="sm">{label}</Title>
                {value === null ? <Text size="sm" color="muted">No snapshot is available.</Text> : <>
                  <BigStat className="statistic" height="auto" label="Latest total" title={metricValue(value)} order="titleBottom" size="lg" />
                  {day && <Text size="sm" color="muted">Snapshot <time datetime={day}>{shortDate(day)}</time> UTC</Text>}
                  {change !== null && <Text className="change" size="sm">{signed.format(change)} since {shortDate(cutoff)}</Text>}
                  {rows.length > 1 ? (
                    <AdoptionTrend
                      label={label}
                      rows={rows}
                      grain={ossGrain}
                      mode="line"
                      axisStart={ossInterval(cutoff)}
                      axisEnd={ossInterval(today)}
                    />
                  ) : <Text size="sm" color="muted">A trend requires multiple snapshots in this window.</Text>}
                </>}
              </Panel>
            ))}
          </div>
        </section>
      ))}
    </div>}

    <section id="methodology" class="data-section" aria-labelledby="methodology-title">
      <div class="section-heading"><Title type="h2" size="lg" id="methodology-title">How we measure adoption</Title></div>
      <dl class="methodology">
        {filters.tab === "self-hosted" ? <>
          <div>
            <dt>Observed growth</dt>
            <dd>Each installation enters the cumulative count once, after its first successful request in retained self-hosted telemetry.</dd>
          </div>
          <div>
            <dt>Installation activity</dt>
            <dd>An installation counts once per period. An active installation recorded a successful request. Coverage depends on which installations report.</dd>
          </div>
          <div>
            <dt>Reported organizations</dt>
            <dd>Verified companies enroll separately. The public directory uses domains shared through optional namespace contact reporting.</dd>
          </div>
          <div>
            <dt>Comparison and projection</dt>
            <dd>Relative changes compare complete days in two fully reported windows. The activity table and CSV project requests from the daily average when each elapsed day has data.</dd>
          </div>
        </> : <>
          <div>
            <dt>SDK downloads</dt>
            <dd>Package registries report download events, which can include automated builds and retries. Relative changes use two fully reported windows.</dd>
          </div>
          <div>
            <dt>Repository and distribution snapshots</dt>
            <dd>Stars, forks, release asset downloads, and container pulls come from cumulative source snapshots.</dd>
          </div>
        </>}
      </dl>
      {filters.tab === "self-hosted" && <Link href="/telemetry" size="sm">Telemetry settings and privacy</Link>}
    </section>
    <Panel className="next-step" padding="lg" gap="sm" hasBorder fillWidth>
      <div>
        <Title type="h2" size="md">Run Loom</Title>
