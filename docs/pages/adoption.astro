---
import { Badge } from "@clickhouse/click-ui/Badge";
import { BigStat } from "@clickhouse/click-ui/BigStat";
import { Button } from "@clickhouse/click-ui/Button";
import { Link } from "@clickhouse/click-ui/Link";
import { Panel } from "@clickhouse/click-ui/Panel";
import { Table } from "@clickhouse/click-ui/Table";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import AdoptionActivity from "../components/AdoptionActivity.astro";
import AdoptionFilters from "../components/AdoptionFilters.mjs";
import AdoptionLifecycle from "../components/AdoptionLifecycle.astro";
import AdoptionTrend from "../components/AdoptionTrend.astro";
import SiteFrame from "../components/SiteFrame.astro";
import { loadPublishedAdoption } from "../lib/adoption-data.mjs";
import {
  activityForRange,
  adoptionCsv,
  adoptionFilters,
  adoptionUrl,
  csvBody,
  daysBefore,
  grains,
  ranges,
  relativeChange,
  summarizeOss,
  thresholds,
} from "../lib/adoption-view.mjs";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
Astro.response.headers.set("Vercel-CDN-Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");

const filters = adoptionFilters(Astro.url.searchParams);
const dataset = Astro.url.searchParams.get("csv");
const tab = dataset ? (dataset === "downloads" || dataset === "stars" ? "oss" : "self-hosted") : filters.tab;
const { today, refreshedAt, selfHosted, openSource } = await loadPublishedAdoption(tab);
const { totals: summaries, retention, versions, activity, lifecycle, domains } = selfHosted;
const totals = summaries?.find(({ range_days, comparison }) => range_days === filters.days && comparison === "current");
const previous = summaries?.find(
  ({ range_days, comparison }) => range_days === filters.days && comparison === "previous",
);
const compare = totals?.days_reported === filters.days && previous?.days_reported === filters.days;
const cutoff = daysBefore(today, filters.days);
const lastCompleteDate = daysBefore(today, 1);
const number = new Intl.NumberFormat("en-US");
const percent = new Intl.NumberFormat("en-US", { style: "percent", maximumFractionDigits: 1 });
const signed = new Intl.NumberFormat("en-US", { signDisplay: "exceptZero" });
const signedPercent = new Intl.NumberFormat("en-US", {
  style: "percent",
  maximumFractionDigits: 1,
  signDisplay: "exceptZero",
});
const series = activityForRange(activity, filters, today);
const lifecycleGroups = [
  { entity: "deployment", threshold: filters.installation, title: "Installation lifecycle" },
  { entity: "domain", threshold: filters.domain, title: "Domain lifecycle" },
].map((group) => ({
  ...group,
  rows: lifecycle.filter(
    (row) =>
      row.entity === group.entity &&
      row.min_requests === group.threshold &&
      row.grain === filters.cohort &&
      row.bucket >= cutoff,
  ),
}));
const oss = summarizeOss(openSource, filters.days, today);
const stars = oss.find(({ id }) => id === "stars");
const sources = {
  GitHub: "https://github.com/ClickHouse/loom",
  PyPI: "https://pypistats.org/packages/clickhouse-loom",
  npm: "https://www.npmjs.com/package/@clickhouse/loom",
  GHCR: "https://github.com/ClickHouse/loom/pkgs/container/loom",
};
if (dataset) {
  const rows = adoptionCsv(dataset, series, lifecycleGroups, oss);
  if (!rows) return new Response("Unknown dataset", { status: 404 });
  return new Response(csvBody(rows), {
    headers: {
      "Content-Type": "text/csv; charset=utf-8",
      "Content-Disposition": `attachment; filename="loom-${dataset}.csv"`,
      "Cache-Control": "public, max-age=300",
    },
  });
}
const metricGroups = [
  {
    title: "Successful requests by feature",
    entries: [
      ["Memory", "memory_requests"],
      ["Code", "code_requests"],
      ["Knowledge", "knowledge_requests"],
      ["Conversations", "conversation_requests"],
      ["Tracker", "tracker_requests"],
      ["Tasks", "task_requests"],
    ],
  },
  {
    title: "Successful requests by transport",
    entries: [
      ["MCP", "mcp_requests"],
      ["HTTP", "http_requests"],
    ],
  },
  {
    title: "Model usage",
    entries: [
      ["LLM calls", "llm_calls"],
      ["Input tokens", "input_tokens"],
      ["Output tokens", "output_tokens"],
      ["Embedding tokens", "embedding_tokens"],
    ],
  },
  {
    title: "Activity per installation",
    description:
      "Median daily peak among active installations. Each day uses the larger count from its two reporting windows.",
    entries: [
      ["Namespaces", "median_namespaces"],
      ["Agents", "median_agents"],
      ["Sessions", "median_sessions"],
    ],
  },
];
const overview = [
  ["Reporting installations", "reporting", "Sent a telemetry report"],
  ["Active installations", "active", "Ran at least one successful request"],
  ["Verified companies", "verified_companies", "Enrolled companies with an active installation"],
  ["Successful requests", "operations", "Successful operations across reporting installations"],
];

const labeledOptions = (labels: Record<string, string>) =>
  Object.entries(labels).map(([value, label]) => ({ value, label }));
const choiceFields = [
  {
    name: "days",
    label: "Lookback",
    value: filters.days,
    options: ranges.map((days) => ({ value: String(days), label: `Last ${days} days` })),
  },
  ...(filters.tab === "self-hosted"
    ? [
        { name: "grain", label: "Activity resolution", value: filters.grain, options: labeledOptions(grains) },
        {
          name: "cohort",
          label: "Lifecycle resolution",
          value: filters.cohort,
          options: labeledOptions({ week: "Weekly", month: "Monthly" }),
        },
        {
          name: "installation",
          label: "Installation threshold",
          value: filters.installation,
          options: labeledOptions(thresholds),
        },
        { name: "domain", label: "Domain threshold", value: filters.domain, options: labeledOptions(thresholds) },
      ]
    : []),
];
const preservedFilters =
  filters.tab === "oss"
    ? {
        tab: filters.tab,
        grain: filters.grain,
        cohort: filters.cohort,
        installation: filters.installation,
        domain: filters.domain,
      }
    : { tab: filters.tab };
---

<SiteFrame
  title="Loom Adoption | ClickHouse Loom"
  description="Self-hosted activity and open-source adoption for ClickHouse Loom."
  path="/adoption"
>
  <Title type="h1" size="xl" family="brand">Loom adoption</Title>
  <Text className="lead" size="lg" color="muted">See where self-hosted Loom reports activity and how developers use its open-source packages.</Text>
  <div class="site-actions">
    <Link className="primary" href={adoptionUrl(filters, { tab: "self-hosted" }, "#reported-contact-domains")}>See reporting domains</Link>
    <Link className="secondary" href="#methodology">How we measure adoption</Link>
    <Link href="/telemetry">Telemetry settings</Link>
  </div>
  <nav class="switcher" aria-label="Adoption views">
    <Link href={adoptionUrl(filters, { tab: "self-hosted" })} aria-current={filters.tab === "self-hosted" ? "page" : undefined}>Self-hosted</Link>
    <Link href={adoptionUrl(filters, { tab: "oss" })} aria-current={filters.tab === "oss" ? "page" : undefined}>Open source</Link>
  </nav>

  <form id="adoption-filters" method="get" action="/adoption" class="filters" aria-label="Adoption filters" data-adoption-filters hidden>
    {Object.entries(preservedFilters).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    <AdoptionFilters client:load fields={choiceFields} form="adoption-filters" fallback="adoption-native-filters" />
    <Button type="secondary" htmlType="submit" label="Apply filters" />
  </form>
  <form id="adoption-native-filters" method="get" action="/adoption" class="filters native-filters" aria-label="Adoption filters" data-adoption-filters>
    {Object.entries(preservedFilters).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    {choiceFields.map(({ label, name, options, value }) => (
      <label>{label}
        <select name={name}>
          {options.map((option) => <option value={option.value} selected={option.value === String(value)}>{option.label}</option>)}
        </select>
      </label>
    ))}
    <Button type="secondary" htmlType="submit" label="Apply filters" />
  </form>

  {filters.tab === "self-hosted" && <section id="self-hosted" aria-labelledby="self-hosted-title">
    <div class="section-title">
      <div>
        <Title type="h2" size="lg" id="self-hosted-title">Self-hosted</Title>
        <Text size="sm" color="muted">{cutoff} to {lastCompleteDate} UTC · {totals ? `${totals.days_reported}/${filters.days} days reported` : "No observations"}</Text>
      </div>
      <Link href="/telemetry">Telemetry and privacy</Link>
    </div>

    {totals ? (
      <div class="metrics">
        {overview.map(([label, key, description]) => {
          const change = compare ? relativeChange(totals[key], previous[key]) : null;
          return <Panel className="card" hasBorder padding="lg">
            <BigStat label={label} title={number.format(totals[key])} order="titleBottom" size="lg" />
            <Text color="muted" size="sm">{description}</Text>
            {change !== null && <Text className="change" size="sm">{signedPercent.format(change)} vs. previous {filters.days} days</Text>}
          </Panel>;
        })}
      </div>
    ) : (
      <Panel className="card coverage" hasBorder padding="lg">
        <Text color="muted" size="sm">{Array.isArray(summaries) ? "No installations reported in this period." : "Self-hosted metrics are unavailable."}</Text>
        <Link href={adoptionUrl(filters, { tab: "oss" })}>View open-source adoption</Link>
      </Panel>
    )}
    {totals && <p class="notice">Latest reporting date <time datetime={totals.last_reported}>{totals.last_reported}</time> UTC. Period changes appear when both windows have a report on every date.</p>}

    <Panel className="card activity domains" id="reported-contact-domains" hasBorder padding="lg">
      <Title type="h3" size="md">Reported contact domains</Title>
      <Text color="muted" size="sm">These self-hosted installations shared a namespace contact domain and recorded at least one successful request in the last 90 complete UTC days.</Text>
      {domains === null ? (
        <Text className="notice" color="muted" size="sm">The domain list is unavailable.</Text>
      ) : domains.length ? (
        <ul class="contact-domains">
          {domains.map((domain) => <li><Badge text={domain} size="md" state="neutral" /></li>)}
        </ul>
      ) : (
        <Text className="notice" color="muted" size="sm">No domains reported activity in this period.</Text>
      )}
    </Panel>

    <Panel className="card activity" id="installation-activity" hasBorder padding="lg">
      <div class="card-title">
        <Title type="h3" size="md">Active installations and request volume</Title>
        <div class="chart-links">
          <Link href={adoptionUrl(filters, {}, "#installation-activity")} aria-label="Link to activity chart">Chart link</Link>
          {series.length > 0 && <Link href={adoptionUrl(filters, { csv: "activity" })}>Download activity CSV</Link>}
        </div>
      </div>
      <p>The chart includes periods starting in the selected window. The projection uses the daily average for the current period when every completed day has data. Installation counts show observed activity.</p>
      {series.length ? <AdoptionActivity rows={series} grain={filters.grain} /> : <p class="notice">No activity series is available for this selection.</p>}
    </Panel>

    <Panel className="card activity" id="lifecycle" hasBorder padding="lg">
      <div class="card-title">
        <Title type="h3" size="md">Adoption lifecycle</Title>
        <div class="chart-links">
          <Link href={adoptionUrl(filters, {}, "#lifecycle")} aria-label="Link to lifecycle chart">Chart link</Link>
          {lifecycleGroups.some(({ rows }) => rows.length > 0) && <Link href={adoptionUrl(filters, { csv: "lifecycle" })}>Download lifecycle CSV</Link>}
        </div>
      </div>
      <p>Thresholds apply per {filters.cohort}. Retained means active in consecutive periods. Reactivated means active after a gap. An installation that stops reporting can appear inactive.</p>
      <div class="panels plots">
        {lifecycleGroups.map(({ title, threshold, rows }) => (
          <div>
            <Title type="h4" size="sm">{title}</Title>
            <p>{thresholds[threshold]}{threshold > 0 && " successful requests"} per {filters.cohort}</p>
            <AdoptionLifecycle title={`View ${title.toLowerCase()} data`} grain={filters.cohort} rows={rows} />
          </div>
        ))}
      </div>
    </Panel>
    <div class="panels">
      {totals && totals.reporting > 0 && metricGroups.map(({ title, description, entries }) => (
        <Panel className="card" hasBorder padding="lg">
          <Title type="h3" size="md">{title}</Title>
          {description && <p>{description}</p>}
          <dl>
            {entries.map(([label, key]) => <div><dt>{label}</dt><dd>{totals[key] === null ? "—" : number.format(totals[key])}</dd></div>)}
          </dl>
        </Panel>
      ))}
      {totals && totals.reporting > 0 && (
        <Panel className="card" hasBorder padding="lg">
          <Title type="h3" size="md">Request outcomes</Title>
          <dl>
            <div><dt>Total requests</dt><dd>{number.format(totals.requests)}</dd></div>
            <div><dt>Successful requests</dt><dd>{number.format(totals.operations)}</dd></div>
            <div><dt>Server errors</dt><dd>{number.format(totals.server_errors)}</dd></div>
          </dl>
        </Panel>
      )}
      {(totals || versions?.length) && (
        <Panel className="card" hasBorder padding="lg">
          <Title type="h3" size="md">Latest reported versions</Title>
          <p>Up to 12 most common version pairs from the last 30 complete UTC days.</p>
          {versions?.length ? <Table
            size="sm"
            mobileLayout="scroll"
            headers={[{ label: "Loom" }, { label: "ClickHouse" }, { label: "Installations" }]}
            rows={versions.map((row) => ({
              id: `${row.loom_version}/${row.clickhouse_version}`,
              items: [{ label: row.loom_version }, { label: row.clickhouse_version }, { label: number.format(row.installations) }],
            }))}
          /> : <p>No version data is available.</p>}
        </Panel>
      )}
      {totals && (
        <Panel className="card" hasBorder padding="lg">
          <Title type="h3" size="md">Weekly installation retention</Title>
          <p>Return activity after an installation’s first observed active week. Includes the last 13 complete UTC cohorts.</p>
          {retention?.length ? <Table
            size="sm"
            mobileLayout="scroll"
            headers={[{ label: "Week" }, { label: "Active / eligible" }, { label: "Retained" }]}
            rows={retention.map(({ age, active, eligible }) => ({
              id: age,
              items: [{ label: age }, { label: `${number.format(active)} / ${number.format(eligible)}` }, { label: percent.format(active / eligible) }],
            }))}
          /> : <p>Retention appears once a cohort has a complete follow-up week.</p>}
        </Panel>
      )}
    </div>
  </section>}

  {filters.tab === "oss" && <section id="oss" aria-labelledby="oss-title">
    <div class="section-title">
      <div>
        <Title type="h2" size="lg" id="oss-title">Open-source adoption</Title>
        <p>SDK downloads from {cutoff} to {lastCompleteDate} UTC. Repository counters show the latest cumulative totals.</p>
      </div>
      <Link href="https://github.com/ClickHouse/loom">View on GitHub</Link>
    </div>
    <div class="panels oss-metrics">
      {oss.map(({ label, source, value, day, days, change, isDownload }) => (
        <Panel className="card" hasBorder padding="lg">
          <BigStat label={label} title={value === null ? "—" : number.format(value)} order="titleBottom" size="lg" />
          <p>
            <Link href={sources[source]}>{source}</Link> · {day ? <time datetime={day}>{day}</time> : "Data unavailable"}
            {days !== undefined && days > 0 && ` · ${days}/${filters.days} days reported`}
          </p>
          {change !== null && <p class="change">{isDownload ? `${signedPercent.format(change)} vs. previous ${filters.days} days` : `${signed.format(change)} since ${cutoff}`}</p>}
        </Panel>
      ))}
    </div>
    <Panel className="card activity" id="downloads" hasBorder padding="lg">
      <div class="card-title">
        <Title type="h3" size="md">Monthly downloads by package</Title>
        <div class="chart-links">
          <Link href={adoptionUrl(filters, {}, "#downloads")} aria-label="Link to downloads chart">Chart link</Link>
          {oss.some((metric) => metric.isDownload && metric.history.length) && <Link href={adoptionUrl(filters, { csv: "downloads" })}>Download SDK CSV</Link>}
        </div>
      </div>
      <p>Each month shows downloads from the days reported by its registry.</p>
      <div class="panels plots">
        {oss.filter(({ isDownload }) => isDownload).map(({ label, monthly, history }) => (
          <div>
            <Title type="h4" size="sm">{label}</Title>
            {monthly.length ? <AdoptionTrend label={label} grain="month" rows={monthly} /> : <p>Data unavailable.</p>}
            <details>
              <summary>Daily download history</summary>
              {history.length ? <AdoptionTrend label={label} rows={history} /> : <p>Data unavailable.</p>}
            </details>
          </div>
        ))}
      </div>
    </Panel>
    <Panel className="card activity" id="github-stars" hasBorder padding="lg">
      <div class="card-title">
        <Title type="h3" size="md">Cumulative GitHub stars</Title>
        <div class="chart-links">
          <Link href={adoptionUrl(filters, {}, "#github-stars")} aria-label="Link to stars chart">Chart link</Link>
          {stars?.history.length > 0 && <Link href={adoptionUrl(filters, { csv: "stars" })}>Download stars CSV</Link>}
        </div>
      </div>
      {stars?.history.length
        ? <AdoptionTrend label="GitHub stars" rows={stars.history} />
        : <p>Daily snapshots will appear as they are collected.</p>}
    </Panel>
    <p class="notice">Downloads can include automated builds and retries.</p>
  </section>}

  <section id="methodology" class="methodology" aria-labelledby="methodology-title">
    <Title type="h2" size="lg" id="methodology-title">How we measure adoption</Title>
    <dl>
      <div>
        <dt>Self-hosted usage</dt>
        <dd>Installations report deployment-level totals by default. Activity counts successful requests. The same installation is counted once per period. Coverage depends on which installations report. <Link href="/telemetry">Telemetry settings and payload</Link></dd>
      </div>
      <div>
        <dt>Company and domain coverage</dt>
        <dd>Verified companies enroll separately. Domain activity comes from self-reported namespace contact domains.</dd>
      </div>
      <div>
        <dt>Open-source distribution</dt>
        <dd>GitHub stars and forks are cumulative snapshots. SDK totals count downloads by package and day. Monthly charts include partial periods and show days reported. Container pulls come from registry totals when available.</dd>
      </div>
    </dl>
  </section>
  <p class="refreshed">Source data fetched <time datetime={refreshedAt}>{today} at {refreshedAt.slice(11, 16)} UTC</time></p>
</SiteFrame>

<script>
  import { omitDefaultAdoptionFilters } from "../lib/adoption-view.mjs";

  document.querySelectorAll<HTMLFormElement>("[data-adoption-filters]").forEach((form) => {
    form.addEventListener("formdata", ({ formData }) => omitDefaultAdoptionFilters(formData));
  });
</script>

<style>
  :global(#content):has(.switcher) { padding-block-start: clamp(2rem, 4vw, 4rem); }
  .switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-block: 1.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .switcher a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-weight: 650;
    text-decoration: none;
  }
  .switcher a:hover, .switcher a[aria-current] { color: var(--accent); }
  .switcher a[aria-current] { border-bottom-color: var(--accent); }
  .filters {
    display: flex;
    inline-size: 100%;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.65rem 0.85rem;
    margin-block-end: 1.5rem;
    padding: 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .filters[hidden] { display: none; }
  .filters:has(> input[name="tab"][value="oss"]) { max-inline-size: 27rem; }
  .filters :global(.adoption-filter), .native-filters label { flex: 1 1 11rem; min-inline-size: 0; }
  .filters > button { flex: none; justify-self: start; }
  .native-filters label { display: grid; gap: 0.4rem; }
  .native-filters select {
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding: 0.5rem;
    border: 1px solid var(--click-global-color-stroke-default);
    border-radius: var(--click-button-radii-all);
    background: var(--click-global-color-background-default);
    color: var(--click-global-color-text-default);
    font: inherit;
  }
  @media (max-width: 76rem) {
    .filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .filters:has(> input[name="tab"][value="oss"]) { grid-template-columns: minmax(0, 1fr) auto; }
  }
  @media (max-width: 46rem) {
    .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 34rem) {
    .filters, .filters:has(> input[name="tab"][value="oss"]) { grid-template-columns: minmax(0, 1fr); }
  }
  .card-title { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; }
  .chart-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .card-title a, .card p a { color: var(--accent); font-size: 0.86rem; }
  .card p.change { color: var(--click-alert-color-text-info); font-variant-numeric: tabular-nums; }
  .section-title {
    display: flex;
    align-items: start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.65rem 1.2rem;
    margin-bottom: 1.2rem;
  }
  .section-title a { font-size: 0.88rem; color: var(--accent); }
  .section-title p, .card p, .notice, .refreshed { font-size: 0.9rem; }
  .section-title p, .card p { margin-top: 0.35rem; }
  .metrics, .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.8rem;
  }
  .panels { grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .oss-metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 55rem) { .oss-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 34rem) { .oss-metrics { grid-template-columns: minmax(0, 1fr); } }
  .metrics + .panels, .activity + .panels, .notice + .panels { margin-top: 0.8rem; }
  .card {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .coverage { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.45rem 1.2rem; padding-block: 0.7rem; }
  .notice, .activity { margin-top: 0.9rem; }
  .domains { scroll-margin-block-start: 5.25rem; }
  .contact-domains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }
  .contact-domains li { max-inline-size: 100%; overflow-wrap: anywhere; }
  details { margin-top: 0.9rem; color: var(--muted); }
  summary { cursor: pointer; font-size: 0.85rem; }
  dd { font-variant-numeric: tabular-nums; }
  dl { display: grid; gap: 0.25rem; margin: 0.55rem 0 0; }
  dl div { display: flex; gap: 0.5rem; justify-content: space-between; padding: 0.35rem 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .plots { margin-top: 0.9rem; }
  .plots > div { min-width: 0; padding: 0.9rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .methodology { margin-top: 1.5rem; }
  .methodology { padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .methodology dl { gap: 0.9rem; }
  .methodology dl div { display: grid; gap: 0.3rem; }
  .methodology dt { font-weight: 650; color: inherit; }
  .methodology dd { font-size: 0.91rem; color: var(--muted); line-height: 1.6; }
  .refreshed { margin-top: 2rem; color: var(--muted); }
</style>
