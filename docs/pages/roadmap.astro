---
import SiteFrame from "../components/SiteFrame.astro";

const roadmap = "https://github.com/ClickHouse/loom/issues/1232";
const areas = [
  {
    title: "Report and investigate knowledge problems",
    detail: "Capture what was missing or wrong, record the evidence, and prepare a proposed correction for review.",
    issues: [
      { label: "Problem reports", href: "https://github.com/ClickHouse/loom/issues/1147" },
      { label: "Investigation and correction plans", href: "https://github.com/ClickHouse/loom/issues/1148" },
    ],
  },
  {
    title: "Review, publish, and reuse corrections",
    detail:
      "Follow a correction from independent review to retrieval by a fresh agent, with links back to the source evidence.",
    issues: [
      { label: "End-to-end workflow", href: "https://github.com/ClickHouse/loom/issues/1185" },
      { label: "Guidance for consuming agents", href: "https://github.com/ClickHouse/loom/issues/1230" },
    ],
  },
  {
    title: "Measure and maintain what agents use",
    detail:
      "Record which revision was returned and what outcome evidence is available. Give important knowledge an owner and a review date.",
    issues: [
      { label: "Usage and outcome evidence", href: "https://github.com/ClickHouse/loom/issues/1149" },
      { label: "Knowledge stewardship", href: "https://github.com/ClickHouse/loom/issues/1175" },
    ],
  },
];
---

<SiteFrame
  title="Knowledge Factory roadmap | ClickHouse Loom"
  description="Follow the public roadmap for connecting knowledge reports, reviewed corrections, reuse, and evidence in Loom."
  path="/roadmap"
>
  <h1>Knowledge Factory roadmap</h1>
  <p class="lead">The goal is to turn mistakes found during agent work into reviewed knowledge that later agents can retrieve, then inspect whether the correction helped.</p>
  <div class="site-actions">
    <a class="primary" href={roadmap}>Follow the roadmap on GitHub</a>
    <a class="secondary" href="https://github.com/ClickHouse/loom/releases">See releases</a>
  </div>

  <section class="site-section" aria-labelledby="tracked-title">
    <div class="section-copy">
      <h2 id="tracked-title">What the roadmap tracks</h2>
      <p>The linked issues carry the current scope, dependencies, and status for each area.</p>
    </div>
    <div class="tracked-areas">
      {areas.map(({ title, detail, issues }) => (
        <article>
          <div class="section-copy">
            <h3>{title}</h3>
            <p>{detail}</p>
          </div>
          <ul>
            {issues.map(({ label, href }) => <li><a class="text-link" href={href}>{label} <span aria-hidden="true">↗</span></a></li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="available-title">
    <div class="section-copy">
      <h2 id="available-title">Available today</h2>
      <p>Start with shared memory, source citations, code links, and review controls. Use the product guide to see how those capabilities fit into your workflow.</p>
    </div>
    <div class="site-actions"><a class="secondary" href="/platform">Explore the product</a></div>
  </section>
</SiteFrame>

<style>
  .tracked-areas { margin-top: 1.4rem; border-top: 1px solid var(--line); }
  .tracked-areas article { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 1rem 2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .tracked-areas ul { list-style: none; display: grid; align-content: center; gap: 0.55rem; margin: 0; padding: 0; }
  @media (max-width: 50rem) { .tracked-areas article { grid-template-columns: minmax(0, 1fr); } }
</style>
