---
import SiteFrame from "../components/SiteFrame.astro";

const controls = [
  {
    title: "Identity and access",
    detail: "Connect an OpenID Connect provider and scope access to team namespaces with roles, grants, and tokens.",
    href: "/docs/operations/sso",
    label: "Review sign-in and configuration",
  },
  {
    title: "Audit and usage",
    detail: "Inspect changes to memory and trace operations, model usage, and costs in your deployment.",
    href: "/docs/features/observability/audit",
    label: "Read about the audit log",
  },
  {
    title: "Retention and erasure",
    detail: "Set expiry where appropriate and use the erasure workflow to track deletion and check for remaining data.",
    href: "/docs/features/memory/retention-and-erasure",
    label: "Review retention and erasure",
  },
  {
    title: "Backups and recovery",
    detail: "Plan backup, restore, and monitoring for the stores and services your deployment uses.",
    href: "/docs/operations/backup-and-recovery",
    label: "Plan backup and recovery",
  },
];

const deployment = [
  {
    title: "Docker",
    detail: "Start a self-hosted instance, connect an agent, and evaluate a workflow on your own infrastructure.",
    href: "/docs/getting-started/quickstart",
    label: "Run the quickstart",
  },
  {
    title: "Kubernetes",
    detail: "Use the Helm chart to configure services, storage, authentication, and the ingress for a team deployment.",
    href: "/docs/operations/kubernetes",
    label: "Deploy with Helm",
  },
];
---

<SiteFrame
  title="Enterprise deployment | ClickHouse Loom"
  description="Evaluate Loom for a team with self-hosted deployment, identity and access controls, audit, observability, and erasure."
  path="/enterprise"
>
  <h1>Run Loom for your team</h1>
  <p class="lead">Self-host Loom on ClickHouse in infrastructure you operate. Set who can access shared knowledge and choose the storage and model providers your deployment uses.</p>
  <div class="site-actions">
    <a class="primary" href="/docs/operations/deployment">Plan a deployment</a>
    <a class="secondary" href="/docs/architecture/security">Review the security model</a>
  </div>

  <section class="site-section" aria-labelledby="deploy-title">
    <div class="section-copy">
      <h2 id="deploy-title">Choose how to deploy</h2>
      <p>Use Docker for an evaluation or configure a Kubernetes deployment with the Helm chart.</p>
    </div>
    <div class="site-grid">
      {deployment.map(({ title, detail, href, label }) => (
        <article class="site-panel">
          <h3>{title}</h3>
          <p>{detail}</p>
          <a href={href}>{label} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="controls-title">
    <div class="section-copy">
      <h2 id="controls-title">Evaluate operational controls</h2>
      <p>Review the settings and responsibilities for running Loom with shared access.</p>
    </div>
    <div class="site-grid">
      {controls.map(({ title, detail, href, label }) => (
        <article class="site-panel">
          <h3>{title}</h3>
          <p>{detail}</p>
          <a href={href}>{label} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="evaluate-title">
    <div class="section-copy">
      <h2 id="evaluate-title">Evaluate on your workload</h2>
      <p>Test the retrieval quality, latency, and operating cost for the agents and repositories you plan to run.</p>
    </div>
    <div class="site-actions">
      <a class="primary" href="/docs/getting-started/evaluate">Run an evaluation</a>
      <a class="text-link" href="/docs/benchmarks/results">See published benchmarks</a>
      <a class="text-link" href="/docs/operations/monitoring">Review monitoring</a>
    </div>
  </section>
</SiteFrame>
