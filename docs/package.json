{
  "name": "clickhouse-loom-docs",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "npm run prepare-content && blume dev",
    "prepare-content": "node scripts/sync-playground-engine.mjs --check && node scripts/prepare-content.mjs && node scripts/prepare-click-ui.mjs",
    "build": "npm run prepare-content && blume build && node scripts/mount-site-pages.mjs",
    "preview": "blume preview",
    "check": "blume check",
    "validate": "npm run prepare-content && blume validate --strict"
  },
  "dependencies": {
    "@clickhouse/click-ui": "0.13.0",
    "@fontsource-variable/inter": "5.2.8",
    "blume": "2.2.7"
  },
  "overrides": {
    "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
    "postcss-selector-parser@<6.1.5": "6.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@orama/orama": "^3.1.18",
    "@oslojs/encoding": "^1.1.0",
    "clsx": "^2.1.1",
    "cookie": "^2.0.2",
    "devalue": "^6.0.3",
    "html-escaper": "^3.0.3",
    "js-yaml": "5.5.0",
    "mdast-util-from-markdown": "2.1.0",
    "mrmime": "^2.0.1",
    "piccolore": "^0.1.3",
    "sharp": "^0.35.5",
    "ufo": "^1.6.4",
    "zod": "^4.6.7"
  }
}
