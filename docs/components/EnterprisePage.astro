---
import { GridContainer } from "@clickhouse/click-ui/GridContainer";
import { Icon } from "@clickhouse/click-ui/Icon";
import { Link } from "@clickhouse/click-ui/Link";
import { Panel } from "@clickhouse/click-ui/Panel";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import SiteFrame from "./SiteFrame.astro";
import { documentationLink } from "./documentation-link";
import { enterpriseCopy } from "./enterprise-copy";
import { enterpriseAlternates, enterpriseLink } from "./site-locales";

interface Props {
  locale: keyof typeof enterpriseCopy;
}

const { locale } = Astro.props;
const copy = enterpriseCopy[locale];
const { href: path } = enterpriseLink(locale);
function guide(path: string, label: string) {
  const link = documentationLink(locale, path);
  return { ...link, label: link.hreflang === locale ? label : `${label} (${copy.englishLabel})` };
}

const plan = guide("/operations/deployment", copy.plan);
const security = guide("/architecture/security", copy.security);
const deployment = [
  { ...copy.docker, ...guide("/getting-started/quickstart", copy.docker.label) },
  { ...copy.kubernetes, ...guide("/operations/kubernetes", copy.kubernetes.label) },
];
const controls = [
  { ...copy.identity, ...guide("/operations/sso", copy.identity.label) },
  { ...copy.audit, ...guide("/features/observability/audit", copy.audit.label) },
  { ...copy.erasure, ...guide("/features/memory/retention-and-erasure", copy.erasure.label) },
  { ...copy.backup, ...guide("/operations/backup-and-recovery", copy.backup.label) },
];
const evaluation = [
  { ...guide("/getting-started/evaluate", copy.evaluate), className: "primary" },
  { ...guide("/benchmarks/results", copy.benchmarks), className: "text-link" },
  {
    ...guide("/use-cases/self-hosted-clickhouse#choose-self-hosted-memory-for-coding-agents", copy.boundary),
    className: "text-link",
  },
  { ...guide("/operations/monitoring", copy.monitoring), className: "text-link" },
];
---

<SiteFrame title={copy.title} description={copy.description} path={path} locale={locale} alternates={enterpriseAlternates}>
  <div class="enterprise-intro">
    <div>
      <Title type="h1" size="xl" family="brand">{copy.heading}</Title>
      <Text color="muted" className="lead">{copy.lead}</Text>
      <div class="site-actions">
        <Link className="primary" href={plan.href} hrefLang={plan.hreflang}>{plan.label}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
        <Link className="secondary" href={security.href} hrefLang={security.hreflang}>{security.label}</Link>
      </div>
    </div>
    <Panel orientation="vertical" alignItems="start" gap="none" hasBorder role="region" className="site-panel deployment" aria-labelledby="deploy-title">
      <Title type="h2" size="lg" id="deploy-title">{copy.deploymentHeading}</Title>
      <Text color="muted">{copy.deploymentIntro}</Text>
      {deployment.map(({ title, detail, href, hreflang, label }) => (
        <article>
          <Title type="h3" size="md">{title}</Title>
          <Text color="muted">{detail}</Text>
          <Link href={href} hrefLang={hreflang}>{label} <Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
        </article>
      ))}
    </Panel>
  </div>

  <section class="site-section" aria-labelledby="controls-title">
    <div class="section-copy">
      <Title type="h2" size="lg" id="controls-title">{copy.controlsHeading}</Title>
      <Text color="muted">{copy.controlsIntro}</Text>
    </div>
    <GridContainer className="site-grid controls" isResponsive={false}>
      {controls.map(({ title, detail, href, hreflang, label }) => (
        <Panel orientation="vertical" alignItems="start" gap="none" hasBorder role="article" className="site-panel">
          <Title type="h3" size="md">{title}</Title>
          <Text color="muted">{detail}</Text>
          <Link href={href} hrefLang={hreflang}>{label} <Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
        </Panel>
      ))}
    </GridContainer>
  </section>

  <section class="site-section evaluation" aria-labelledby="evaluate-title">
    <div class="section-copy">
      <Title type="h2" size="lg" id="evaluate-title">{copy.evaluateHeading}</Title>
      <Text color="muted">{copy.evaluateIntro}</Text>
    </div>
    <div class="site-actions">
      {evaluation.map(({ href, hreflang, label, className }) => (
        <Link className={className} href={href} hrefLang={hreflang}>{label}</Link>
      ))}
    </div>
  </section>
</SiteFrame>

<style>
  .enterprise-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 5vw, 5rem); }
  .deployment { border-block-start: 2px solid var(--accent); }
  .deployment h2 { font-size: clamp(1.35rem, 2vw, 1.8rem); }
  .deployment article { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .deployment article p { font-size: 0.94rem; }
  .controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .controls .site-panel { display: flex; flex-direction: column; align-items: start; }
  .controls a { margin-top: auto; }
  .evaluation { padding: clamp(1.1rem, 3vw, 2.45rem); border: 1px solid var(--line); border-inline-start: 0.2rem solid var(--accent); background: var(--surface); }
  @media (min-width: 85rem) { .controls { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 59rem) { .enterprise-intro { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 39rem) { .controls { grid-template-columns: minmax(0, 1fr); } }
</style>
