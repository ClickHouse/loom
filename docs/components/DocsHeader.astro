---
import type { ComponentProps } from "astro/types";
import BlumeHeader from "blume/components/layout/Header.astro";
import DocsHomeLink from "./DocsHomeLink.astro";
import SiteHeader from "./SiteHeader.astro";
import { siteLocales, type SiteLocale } from "./site-locales";

type Props = ComponentProps<typeof BlumeHeader>;

const language = Astro.props.locale ?? "en";
const locale = Object.hasOwn(siteLocales, language) ? (language as SiteLocale) : "en";
const path = Astro.url.pathname.replace(/\/$/, "");
---

<SiteHeader {locale} {path} documentation />
<BlumeHeader {...Astro.props} layout={{ ...Astro.props.layout, Logo: DocsHomeLink }} />
