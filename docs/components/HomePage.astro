---
import { Image } from "astro:assets";
import dashboard from "../assets/screenshots/memory-linked-code.webp";
import ContextPreview from "./ContextPreview.astro";
import SiteFrame from "./SiteFrame.astro";
import { documentationLink } from "./documentation-link";
import { homeCopy } from "./home-copy";
import { enterpriseLink, siteLocales, type SiteLocale } from "./site-locales";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const homeLocale = siteLocales[locale];
const languageNames = new Intl.DisplayNames(locale, { type: "language" });
const docLink = (path: string) => documentationLink(locale, path);
const start = docLink("/getting-started/quickstart");
const enterprise = enterpriseLink(locale);
const knowledgeFactory =
  "knowledgeFactory" in homeLocale
    ? { href: homeLocale.knowledgeFactory, hreflang: locale }
    : docLink("/use-cases/knowledge-factory");
const capabilities = [
  { ...copy.memory, ...docLink("/use-cases/agent-memory") },
  { ...copy.documents, ...docLink("/use-cases/document-search") },
  { ...copy.code, ...docLink("/use-cases/memory-linked-to-code") },
];
const useCases = [
  {
    label: copy.softwareFactory,
    href: "/docs/use-cases/multi-agent#choosing-memory-for-a-software-factory",
    hreflang: "en",
  },
  { label: copy.knowledgeFactory, ...knowledgeFactory },
  { label: copy.autonomous, ...docLink("/use-cases/autonomous-agents") },
  { label: copy.selfHosted, ...docLink("/use-cases/self-hosted-clickhouse") },
];
---

<SiteFrame title={copy.title} description={copy.description} path={homeLocale.href} home={{ locale, start }}>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-content">
      <p class="deployment">{copy.deployment}</p>
      <h1 id="home-title">{copy.heading}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="site-actions">
        <a class="primary" href="/playground/source-change" lang="en" hreflang="en">
          {locale === "en" ? "Try the Playground" : "Playground"}<span class="link-arrow" aria-hidden="true">→</span>
        </a>
        <a class="secondary" {...start}>{copy.run}</a>
      </div>
    </div>
    {locale === "en" ? <ContextPreview /> : <figure class="preview">
      <Image
        src={dashboard}
        format="webp"
        widths={[360, 480, 640, 800, 960, dashboard.width]}
        sizes="(max-width: 63rem) 92vw, (max-width: 108rem) 48vw, 52rem"
        loading="eager"
        alt={copy.screenshotAlt}
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>{copy.screenshotCaption}</figcaption>
    </figure>}
  </section>

  <section class="site-section capabilities" aria-labelledby="product-title">
    <div class="section-heading">
      <div class="section-copy">
        <h2 id="product-title">{copy.contextHeading}</h2>
        <p>{copy.contextDetail}</p>
      </div>
      <a class="text-link" href="/platform" hreflang="en">{copy.product} <span class="link-arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="site-grid">
      {capabilities.map(({ title, detail, href, hreflang, link }) => (
        <article class="site-panel">
          <h3>{title}</h3>
          <p>{detail}</p>
          <a href={href} hreflang={hreflang}>{link} <span class="link-arrow" aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <div class="interfaces">
      <a {...docLink("/getting-started/connect-a-coding-agent")}>{copy.connect}</a>
      <a {...docLink("/getting-started/first-agent")}>{copy.sdk}</a>
    </div>
  </section>

  <section class="site-section" aria-labelledby="use-cases-title">
    <div class="section-copy">
      <h2 id="use-cases-title">{copy.useCasesHeading}</h2>
      <p>{copy.useCasesDetail}</p>
    </div>
    <nav class="use-cases" aria-label={copy.useCasesLabel}>
      {useCases.map(({ label, href, hreflang }) => (
        <a href={href} hreflang={hreflang}>
          <span>{label}{hreflang !== locale && ` (${languageNames.of(hreflang)})`}</span>
          <span class="link-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  </section>

  <section class="site-section evaluation" aria-labelledby="evaluation-title">
    <div class="section-copy">
      <h2 id="evaluation-title">{copy.evaluationHeading}</h2>
      <p>{copy.evaluationDetail}</p>
    </div>
    <div class="site-actions">
      <a class="primary" {...enterprise}>{copy.deploymentOptions}<span class="link-arrow" aria-hidden="true">→</span></a>
      <a class="secondary" {...docLink("/getting-started/evaluate")}>{copy.evaluate}</a>
    </div>
  </section>
</SiteFrame>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr);
    gap: clamp(1.8rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(0rem, 1vw, 1.4rem);
  }
  .deployment { font-size: 0.84rem; font-weight: 600; margin-bottom: 1rem; }
  .hero h1 { max-width: 15ch; font-size: clamp(2.65rem, 5.4vw, 5.9rem); }
  .hero .lead { max-width: 44ch; }
  .interfaces { display: flex; flex-wrap: wrap; gap: 0.65rem 1.25rem; margin-top: 1rem; font-size: 0.91rem; }
  .interfaces a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .interfaces a:hover { color: var(--accent); }
  .preview {
    min-width: 0;
    margin: 0;
    padding: clamp(0.65rem, 1.6vw, 1.35rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .preview img { width: 100%; height: auto; display: block; border: 1px solid var(--line); border-radius: 0.45rem; }
  .preview figcaption { margin-top: 0.7rem; font-size: 0.89rem; color: var(--muted); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  .capabilities .site-panel { display: flex; flex-direction: column; align-items: start; }
  .capabilities .site-panel a { margin-top: auto; }
  .use-cases { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; margin-top: 1.35rem; }
  .use-cases a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; padding-block: 0.5rem; border-top: 1px solid var(--line); text-decoration: none; }
  .use-cases a:hover { color: var(--accent); }
  .use-cases .link-arrow { color: var(--accent); }
  .evaluation { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem 2rem; padding: clamp(1.25rem, 3.3vw, 2.75rem); border: 1px solid var(--line); border-inline-start: 0.2rem solid var(--accent); background: var(--surface); }
  .evaluation .site-actions { margin-top: 0; }
  @media (max-width: 59rem) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero h1 { max-width: 16ch; }
  }
  @media (max-width: 37rem) { .use-cases { grid-template-columns: minmax(0, 1fr); } }
</style>
