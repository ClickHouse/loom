---
import { GridContainer } from "@clickhouse/click-ui/GridContainer";
import { Icon } from "@clickhouse/click-ui/Icon";
import { Link } from "@clickhouse/click-ui/Link";
import { Panel } from "@clickhouse/click-ui/Panel";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import { Image } from "astro:assets";
import dashboard from "../assets/screenshots/memory-linked-code.webp";
import ContextPreview from "./ContextPreview.astro";
import SiteFrame from "./SiteFrame.astro";
import { documentationLink } from "./documentation-link";
import { homeAdoptionCopy, homeCopy } from "./home-copy";
import { enterpriseLink, siteLocales, type SiteLocale } from "./site-locales";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const adoption = homeAdoptionCopy[locale];
const homeLocale = siteLocales[locale];
const languageNames = new Intl.DisplayNames(locale, { type: "language" });
const docLink = (path: string) => documentationLink(locale, path);
const start = docLink("/getting-started/quickstart");
const connect = docLink("/getting-started/connect-a-coding-agent");
const firstAgent = docLink("/getting-started/first-agent");
const evaluate = docLink("/getting-started/evaluate");
const enterprise = enterpriseLink(locale);
const knowledgeFactory =
  "knowledgeFactory" in homeLocale
    ? { href: homeLocale.knowledgeFactory, hreflang: locale }
    : docLink("/use-cases/knowledge-factory");
const capabilities = [
  { ...copy.memory, ...docLink("/use-cases/agent-memory") },
  { ...copy.documents, ...docLink("/use-cases/document-search") },
  { ...copy.code, ...docLink("/use-cases/memory-linked-to-code") },
];
const useCases = [
  {
    label: copy.softwareFactory,
    href: "/docs/use-cases/multi-agent#choosing-memory-for-a-software-factory",
    hreflang: "en",
  },
  { label: copy.knowledgeFactory, ...knowledgeFactory },
  { label: copy.autonomous, ...docLink("/use-cases/autonomous-agents") },
  { label: copy.selfHosted, ...docLink("/use-cases/self-hosted-clickhouse") },
];
---

<SiteFrame title={copy.title} description={copy.description} path={homeLocale.href} home={{ locale, start }}>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-content">
      <Text color="muted" className="deployment">{copy.deployment}</Text>
      <Title type="h1" size="xl" family="brand" id="home-title">{copy.heading}</Title>
      <Text color="muted" className="lead">{copy.lead}</Text>
      <div class="site-actions">
        <Link className="primary" href="/playground/source-change" lang="en" hrefLang="en">
          {locale === "en" ? "Try the Playground" : "Playground"}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" />
        </Link>
        <Link className="secondary" href={start.href} hrefLang={start.hreflang}>{copy.run}</Link>
      </div>
    </div>
    {locale === "en" ? <ContextPreview /> : <figure class="preview">
      <Image
        src={dashboard}
        format="webp"
        widths={[360, 480, 640, 800, 960, dashboard.width]}
        sizes="(max-width: 59rem) 94vw, (min-width: 96rem) 56vw, 46vw"
        loading="eager"
        alt={copy.screenshotAlt}
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>{copy.screenshotCaption}</figcaption>
    </figure>}
  </section>

  <section class="site-section capabilities" aria-labelledby="product-title">
    <div class="section-heading">
      <div class="section-copy">
        <Title type="h2" size="lg" id="product-title">{copy.contextHeading}</Title>
        <Text color="muted">{copy.contextDetail}</Text>
      </div>
      <Link className="text-link" href="/platform" hrefLang="en">{copy.product} <Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
    </div>
    <GridContainer className="site-grid" isResponsive={false}>
      {capabilities.map(({ title, detail, href, hreflang, link }) => (
        <Panel orientation="vertical" alignItems="start" gap="none" hasBorder role="article" className="site-panel">
          <Title type="h3" size="md">{title}</Title>
          <Text color="muted">{detail}</Text>
          <Link href={href} hrefLang={hreflang}>{link} <Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
        </Panel>
      ))}
    </GridContainer>
    <div class="interfaces">
      <Link href={connect.href} hrefLang={connect.hreflang}>{copy.connect}</Link>
      <Link href={firstAgent.href} hrefLang={firstAgent.hreflang}>{copy.sdk}</Link>
    </div>
  </section>

  <Panel className="site-section adoption-proof" role="region" aria-labelledby="adoption-title" color="muted" hasBorder fillWidth>
    <div class="section-copy">
      <Title type="h2" size="lg" id="adoption-title">{adoption.heading}</Title>
      <Text color="muted">{adoption.detail}</Text>
    </div>
    <div class="site-actions">
      <Link className="primary" href="/adoption" hrefLang="en">{adoption.metrics}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
      <Link className="secondary" href="/adoption#reported-contact-domains" hrefLang="en">{adoption.domains}</Link>
    </div>
  </Panel>

  <section class="site-section" aria-labelledby="use-cases-title">
    <div class="section-copy">
      <Title type="h2" size="lg" id="use-cases-title">{copy.useCasesHeading}</Title>
      <Text color="muted">{copy.useCasesDetail}</Text>
    </div>
    <nav class="use-cases" aria-label={copy.useCasesLabel}>
      {useCases.map(({ label, href, hreflang }) => (
        <Link href={href} hrefLang={hreflang}>
          <span>{label}{hreflang !== locale && ` (${languageNames.of(hreflang)})`}</span>
          <Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" />
        </Link>
      ))}
    </nav>
  </section>

  <section class="site-section evaluation" aria-labelledby="evaluation-title">
    <div class="section-copy">
      <Title type="h2" size="lg" id="evaluation-title">{copy.evaluationHeading}</Title>
      <Text color="muted">{copy.evaluationDetail}</Text>
    </div>
    <div class="site-actions">
      <Link className="primary" href={enterprise.href} hrefLang={enterprise.hreflang}>{copy.deploymentOptions}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
      <Link className="secondary" href={evaluate.href} hrefLang={evaluate.hreflang}>{copy.evaluate}</Link>
    </div>
  </section>
</SiteFrame>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr);
    gap: clamp(1.8rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(0rem, 1vw, 1.4rem);
  }
  .deployment { font-size: 0.84rem; font-weight: 600; margin-bottom: 1rem; }
  .hero h1 { max-width: 15ch; font-size: clamp(2.65rem, 5.4vw, 5.9rem); }
  .hero .lead { max-width: 44ch; }
  .interfaces { display: flex; flex-wrap: wrap; gap: 0.65rem 1.25rem; margin-top: 1rem; font-size: 0.91rem; }
  .interfaces a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .interfaces a:hover { color: var(--accent); }
  .preview {
    min-width: 0;
    margin: 0;
    padding: clamp(0.65rem, 1.6vw, 1.35rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .preview img { width: 100%; height: auto; display: block; border: 1px solid var(--line); border-radius: 0.45rem; }
  .preview figcaption { margin-top: 0.7rem; font-size: 0.89rem; color: var(--muted); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  .capabilities .site-panel { display: flex; flex-direction: column; align-items: start; }
  .capabilities .site-panel a { margin-top: auto; }
  .use-cases { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; margin-top: 1.35rem; }
  .use-cases a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; padding-block: 0.5rem; border-top: 1px solid var(--line); text-decoration: none; }
  .use-cases a:hover { color: var(--accent); }
  .use-cases .link-arrow { color: var(--accent); }
  .evaluation { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem 2rem; padding: clamp(1.25rem, 3.3vw, 2.75rem); border: 1px solid var(--line); border-inline-start: 0.2rem solid var(--accent); background: var(--surface); }
  .adoption-proof { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.25rem 2rem; padding: clamp(1.25rem, 3.3vw, 2.75rem); }
  .adoption-proof .site-actions { margin-top: 0; }
  .evaluation .site-actions { margin-top: 0; }
  @media (min-width: 96rem) {
    .hero { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  }
  @media (max-width: 59rem) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero h1 { max-width: 16ch; }
  }
  @media (max-width: 37rem) { .use-cases { grid-template-columns: minmax(0, 1fr); } }
</style>
