---
import { Image } from "astro:assets";
import data from "blume:data";
import dashboard from "../assets/screenshots/memory-linked-code.webp";
import SiteFrame from "./SiteFrame.astro";
import { homeCopy } from "./home-copy";
import { siteLocales, type SiteLocale } from "./site-locales";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const docsPaths = new Set(data.routes.filter((route) => !route.fallback && !route.draft).map(({ path }) => path));
function docLink(path: string) {
  const translated = `/${locale}${path}`;
  return locale !== "en" && docsPaths.has(translated)
    ? { href: `/docs${translated}`, hreflang: locale }
    : { href: `/docs${path}`, hreflang: "en" };
}
const start = docLink("/getting-started/quickstart");
const capabilities = [
  { ...copy.memory, ...docLink("/use-cases/agent-memory") },
  { ...copy.documents, ...docLink("/use-cases/document-search") },
  { ...copy.code, ...docLink("/use-cases/memory-linked-to-code") },
];
const useCases = [
  { label: copy.softwareFactory, ...docLink("/use-cases/multi-agent") },
  { label: copy.knowledgeFactory, ...docLink("/use-cases/knowledge-factory") },
  { label: copy.autonomous, ...docLink("/use-cases/autonomous-agents") },
  { label: copy.selfHosted, ...docLink("/use-cases/self-hosted-clickhouse") },
];
---

<SiteFrame title={copy.title} description={copy.description} path={siteLocales[locale].href} home={{ locale, start }}>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-content">
      <p class="deployment">{copy.deployment}</p>
      <h1 id="home-title">{copy.heading}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="site-actions">
        <a class="primary" {...start}>{copy.run}</a>
        <a class="secondary" href="/platform" hreflang="en">{copy.product}</a>
      </div>
      <p class="interfaces">
        <a {...docLink("/getting-started/connect-a-coding-agent")}>{copy.connect}</a>
        <span aria-hidden="true">·</span>
        <a {...docLink("/getting-started/first-agent")}>{copy.sdk}</a>
      </p>
    </div>
    <figure class="preview">
      <Image
        src={dashboard}
        format="webp"
        widths={[360, 480, 640, 800, 960, dashboard.width]}
        sizes="(max-width: 63rem) 92vw, (max-width: 108rem) 48vw, 52rem"
        loading="eager"
        alt={copy.screenshotAlt}
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>{copy.screenshotCaption}</figcaption>
    </figure>
  </section>

  <section class="site-section" aria-labelledby="product-title">
    <div class="section-copy">
      <h2 id="product-title">{copy.contextHeading}</h2>
      <p>{copy.contextDetail}</p>
    </div>
    <div class="site-grid">
      {capabilities.map(({ title, detail, href, hreflang, link }) => (
        <article class="site-panel">
          <h3>{title}</h3>
          <p>{detail}</p>
          <a href={href} hreflang={hreflang}>{link} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="use-cases-title">
    <div class="section-copy">
      <h2 id="use-cases-title">{copy.useCasesHeading}</h2>
      <p>{copy.useCasesDetail}</p>
    </div>
    <nav class="site-actions" aria-label={copy.useCasesLabel}>
      {useCases.map(({ label, href, hreflang }) => <a class="text-link" href={href} hreflang={hreflang}>{label}</a>)}
    </nav>
  </section>

  <section class="site-section evaluation" aria-labelledby="evaluation-title">
    <div class="section-copy">
      <h2 id="evaluation-title">{copy.evaluationHeading}</h2>
      <p>{copy.evaluationDetail}</p>
    </div>
    <div class="site-actions">
      <a class="secondary" {...docLink("/getting-started/evaluate")}>{copy.evaluate}</a>
      <a class="text-link" href="/enterprise" hreflang="en">{copy.deploymentOptions}</a>
    </div>
  </section>
</SiteFrame>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.16fr);
    gap: clamp(1.6rem, 4vw, 5rem);
    align-items: center;
  }
  .deployment { color: var(--accent); font-size: 0.87rem; font-weight: 650; margin-bottom: 1rem; }
  .hero h1 { max-width: 15ch; font-size: clamp(2.85rem, 4.95vw, 5.6rem); text-wrap: balance; }
  .hero .lead { max-width: 37rem; }
  .interfaces { display: flex; flex-wrap: wrap; gap: 0.4rem 0.75rem; margin-top: 1rem; font-size: 0.88rem; }
  .interfaces a:hover { color: var(--accent); }
  .preview {
    min-width: 0;
    margin: 0;
    padding: clamp(0.65rem, 1.6vw, 1.35rem);
    border: 1px solid #494438;
    border-radius: 0.85rem;
    background: radial-gradient(ellipse at 80% 0, #4d4125, transparent 68%), #222019;
    box-shadow: 0 1.4rem 3.2rem #0005;
  }
  .preview img { width: 100%; height: auto; display: block; border: 1px solid var(--line); border-radius: 0.45rem; }
  .preview figcaption { margin-top: 0.8rem; font-size: 0.86rem; color: var(--muted); }
  .evaluation { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem 2rem; }
  .evaluation .site-actions { margin-top: 0; }
  @media (max-width: 63rem) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero h1 { max-width: 16ch; }
  }
</style>
