---
import { Link } from "@clickhouse/click-ui/Link";
import { Separator } from "@clickhouse/click-ui/Separator";
import loomLogo from "../public/loom.svg?raw";
import { documentationOverview } from "./documentation-link";
import { frameCopy } from "./site-frame-copy";
import { siteLocales, type SiteLocale } from "./site-locales";
import "./click-ui-dark.css";

interface Props {
  locale?: SiteLocale;
}

const language = Astro.props.locale ?? Astro.currentLocale ?? "en";
const locale = Object.hasOwn(siteLocales, language) ? (language as SiteLocale) : "en";
const { href } = siteLocales[locale];
const overview = documentationOverview(locale);
const current = Astro.url.pathname.replace(/\/$/, "") === overview.href;
---

<div class="docs-brand">
  <Link className="brand-home" href={href} aria-label="ClickHouse Loom" lang="en" dir="ltr" weight="semibold">
    <span class="brand-mark" aria-hidden="true" set:html={loomLogo} />
    <span><span class="brand-publisher">ClickHouse </span><strong>Loom</strong></span>
  </Link>
  <Separator className="brand-divider" decorative orientation="vertical" size="sm" />
  <Link className="docs-overview" href={overview.href} hrefLang={overview.hreflang} aria-current={current ? "page" : undefined} size="sm">{frameCopy[locale].docs}</Link>
</div>

<style>
  .docs-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    white-space: nowrap;
  }

  .docs-brand :global(.brand-home), .docs-brand :global(.docs-overview) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .docs-brand :global(.brand-home) {
    gap: 0.45rem;
    min-width: 0;
    color: var(--blume-foreground);
    font-size: 1.0625rem;
    font-weight: 560;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .docs-brand :global(.brand-home strong) { font-weight: 730; }
  .docs-brand :global(.brand-home span:last-child) { overflow: hidden; text-overflow: ellipsis; }
  .brand-mark, .brand-mark :global(svg) { display: block; width: 1.75rem; height: 1.75rem; }
  .brand-mark, .docs-brand :global(.brand-divider), .docs-brand :global(.docs-overview) { flex-shrink: 0; }
  .docs-brand :global(.brand-divider) { block-size: 1rem; }
  .docs-brand :global(.docs-overview:not(:hover, [aria-current="page"])) { color: var(--click-global-color-text-muted); }
  .docs-brand :global(.docs-overview[aria-current="page"]) { color: var(--click-global-color-text-default); }
  @media (max-width: 34rem) { .brand-publisher { display: none; } }
</style>
