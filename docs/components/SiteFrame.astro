---
import { Container } from "@clickhouse/click-ui/Container";
import { Icon } from "@clickhouse/click-ui/Icon";
import { Link } from "@clickhouse/click-ui/Link";
import { publisher, repositoryUrl, software, website } from "../lib/site-identity.mjs";
import loomLogo from "../public/loom.svg?raw";
import { documentationLink, documentationOverview } from "./documentation-link";
import { frameCopy } from "./site-frame-copy";
import { enterpriseLink, homeAlternates, siteLocales, type LocaleAlternate, type SiteLocale } from "./site-locales";
import "./click-ui-dark.css";
import "./site-frame.css";

interface Props {
  title: string;
  description: string;
  path: string;
  locale?: SiteLocale;
  alternates?: LocaleAlternate[];
  home?: { locale: SiteLocale; start: { href: string; hreflang: string } };
}

const { title, description, path, home, locale: pageLocale, alternates } = Astro.props;
const locale = home?.locale ?? pageLocale ?? "en";
const shortLocale = locale === "zh-CN" ? "简体" : locale === "zh-Hant" ? "繁體" : locale.split("-")[0].toUpperCase();
const labels = frameCopy[locale];
const docsLocales = (Object.keys(siteLocales) as SiteLocale[]).flatMap((language) => {
  const overview = documentationOverview(language);
  return overview.hreflang === language ? [{ name: siteLocales[language].name, ...overview }] : [];
});
const pageAlternates = home ? homeAlternates : (alternates ?? []);
const languageMenu = pageAlternates.flatMap(({ language, href }) =>
  language === "x-default" ? [] : [{ language, href, name: siteLocales[language].name }],
);
const brandHome = siteLocales[locale].href;
const { href: startHref, hreflang: startLanguage } =
  home?.start ?? documentationLink(locale, "/getting-started/quickstart");
const canonical = new URL(path, Astro.site);
const page = {
  "@type": "WebPage",
  "@id": new URL("#page", canonical).href,
  name: title,
  description,
  url: canonical.href,
  inLanguage: locale,
  isPartOf: { "@id": website["@id"] },
  publisher: { "@id": publisher["@id"] },
  about: { "@id": software["@id"] },
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": path === "/" ? [website, publisher, software, page] : [page],
};
// Search engines verify this public site's ownership from its homepage.
const searchVerification = {
  "google-site-verification": "zAhVtIsYdw5ZX9BICx7n53DkRaonzhBsK6uOYyk-chQ",
  "msvalidate.01": "189DA06B0EB7CA657F91BF1A2D63BB67",
  "yandex-verification": "bc461af94f4cec32",
};
const navigation = [
  { label: labels.product, href: "/platform", hreflang: "en" },
  { label: "Playground", href: "/playground/source-change", hreflang: "en" },
  { label: labels.enterprise, ...enterpriseLink(locale) },
  { label: labels.adoption, href: "/adoption", hreflang: "en" },
  { label: labels.docs, ...documentationOverview(locale) },
];
---

<!doctype html>
<html lang={locale} dir={locale === "ar" ? "rtl" : undefined} data-cui-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={website.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" type="text/plain" href="/docs/llms.txt" />
    {pageAlternates.map(({ language, href }) => (
      <link rel="alternate" hreflang={language} href={new URL(href, Astro.site)} />
    ))}
    <link rel="icon" href="/docs/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {path === "/" && Object.entries(searchVerification).map(([name, content]) => <meta name={name} content={content} />)}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <Link className="skip" href="#content">{labels.skip}</Link>
    <header class="site-header">
      <Container className="shell header-inner" isResponsive={false} justifyContent="space-between">
        <Link className="brand" href={brandHome}>
          <span class="brand-mark" aria-hidden="true" set:html={loomLogo} />
          <span lang="en" dir="ltr">ClickHouse <strong>Loom</strong></span>
        </Link>
        <nav class="site-nav" aria-label={labels.navigation}>
          {navigation.map(({ label, href, hreflang }) => (
            <Link size="sm" href={href} hrefLang={hreflang} aria-current={path === href ? "page" : undefined}>{label}</Link>
          ))}
          {!home && <Link className="mobile-start" href={startHref} hrefLang={startLanguage}>{labels.start}</Link>}
        </nav>
        <div class="header-actions">
          {languageMenu.length > 0 && (
            <details class="site-language">
              <summary aria-label={`${labels.siteLanguage} · ${siteLocales[locale].name} (${shortLocale})`}>
                <span class="site-language-name">{siteLocales[locale].name}</span>
                <span class="site-language-code" aria-hidden="true">{shortLocale}</span>
              </summary>
              <nav class="site-language-list" aria-label={labels.siteLanguage}>
                {languageMenu.map(({ language, name, href }) => (
                  <Link href={href} lang={language} dir="auto" hrefLang={language} aria-current={language === locale ? "page" : undefined}>
                    {name}
                  </Link>
                ))}
              </nav>
            </details>
          )}
          <Link className="repo-link" href={repositoryUrl} aria-label={labels.github} title={labels.github}>
            <Icon name="github" theme="dark" size="md" aria-hidden="true" />
          </Link>
          <Link className="secondary header-action" href={startHref} hrefLang={startLanguage}>{labels.start}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
        </div>
      </Container>
    </header>
    <Container component="main" display="block" id="content" className="shell" tabIndex={-1}><slot /></Container>
    <footer class="site-footer">
      <Container className="shell footer-inner" isResponsive={false} justifyContent="space-between" wrap="wrap">
        <div>
          <Link className="brand" href={brandHome}>
            <span class="brand-mark" aria-hidden="true" set:html={loomLogo} />
            <span lang="en" dir="ltr">ClickHouse <strong>Loom</strong></span>
          </Link>
        </div>
        <nav aria-label={labels.resources}>
          <Link href={startHref} hrefLang={startLanguage}>{labels.start}</Link>
          <Link href="/adoption" hrefLang="en" aria-current={path === "/adoption" ? "page" : undefined}>{labels.adoption}</Link>
          <Link href={repositoryUrl}>GitHub</Link>
          <Link href={`${repositoryUrl}/releases`} hrefLang="en">{labels.releases}</Link>
          <Link href="/docs/benchmarks/results" hrefLang="en">{labels.benchmarks}</Link>
          <Link href="/telemetry" hrefLang="en">{labels.telemetry}</Link>
        </nav>
        <nav class="footer-languages" aria-labelledby="footer-language-label">
          <span id="footer-language-label">{labels.docsLanguages}</span>
          {docsLocales.map(({ name, href, hreflang }) => (
            <Link href={href} lang={hreflang} dir="auto" hrefLang={hreflang}>{name}</Link>
          ))}
        </nav>
      </Container>
    </footer>
  </body>
</html>
