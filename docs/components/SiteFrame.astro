---
import { publisher, repositoryUrl, software, website } from "../lib/site-identity.mjs";
import loomLogo from "../public/loom.svg?raw";
import { frameCopy } from "./site-frame-copy";
import { homeAlternates, siteLocales, type SiteLocale } from "./site-locales";

interface Props {
  title: string;
  description: string;
  path: string;
  home?: { locale: SiteLocale; start: { href: string; hreflang: string } };
}

const { title, description, path, home } = Astro.props;
const locale = home?.locale ?? "en";
const shortLocale = locale === "zh-CN" ? "简体" : locale === "zh-Hant" ? "繁體" : locale.split("-")[0].toUpperCase();
const labels = frameCopy[locale];
const locales = Object.entries(siteLocales).map(([language, value]) => ({ language, ...value }));
const brandHome = siteLocales[locale].href;
const docs = siteLocales[locale].docs;
const start = home?.start ?? { href: "/docs/getting-started/quickstart", hreflang: "en" };
const canonical = new URL(path, Astro.site);
const page = {
  "@type": "WebPage",
  "@id": new URL("#page", canonical).href,
  name: title,
  description,
  url: canonical.href,
  inLanguage: locale,
  isPartOf: { "@id": website["@id"] },
  publisher: { "@id": publisher["@id"] },
  about: { "@id": software["@id"] },
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": path === "/" ? [website, publisher, software, page] : [page],
};
// Search engines verify this public site's ownership from its homepage.
const searchVerification = {
  "google-site-verification": "zAhVtIsYdw5ZX9BICx7n53DkRaonzhBsK6uOYyk-chQ",
  "msvalidate.01": "189DA06B0EB7CA657F91BF1A2D63BB67",
  "yandex-verification": "bc461af94f4cec32",
};
const navigation = [
  { label: labels.product, href: "/platform", hreflang: "en" },
  { label: labels.enterprise, href: "/enterprise", hreflang: "en" },
  { label: labels.adoption, href: "/adoption", hreflang: "en" },
  { label: labels.docs, href: docs ?? siteLocales.en.docs, hreflang: docs ? locale : "en" },
];
---

<!doctype html>
<html lang={locale} dir={locale === "ar" ? "rtl" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={website.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" type="text/plain" href="/docs/llms.txt" />
    {home && homeAlternates.map(({ language, href }) => (
      <link rel="alternate" hreflang={language} href={new URL(href, Astro.site)} />
    ))}
    <link rel="icon" href="/docs/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {path === "/" && Object.entries(searchVerification).map(([name, content]) => <meta name={name} content={content} />)}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a class="skip" href="#content">{labels.skip}</a>
    <header class="site-header">
      <div class:list={["shell header-inner", { "homepage-header": Boolean(home) }]}>
        <a class="brand" href={brandHome}>
          <span class="brand-mark" aria-hidden="true" set:html={loomLogo} />
          <span lang="en" dir="ltr">ClickHouse Loom</span>
        </a>
        <nav aria-label={labels.navigation}>
          {navigation.map(({ label, href, hreflang }) => (
            <a href={href} hreflang={hreflang} aria-current={path === href ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="header-action" {...start}>{labels.start} <span aria-hidden="true">↗</span></a>
          {home && (
            <details class="site-language">
              <summary aria-label={`${labels.siteLanguage} · ${siteLocales[locale].name} (${shortLocale})`}>
                <span class="site-language-name">{siteLocales[locale].name}</span>
                <span class="site-language-code" aria-hidden="true">{shortLocale}</span>
              </summary>
              <nav class="site-language-list" aria-label={labels.siteLanguage}>
                {locales.map(({ language, name, href }) => (
                  <a href={href} lang={language} dir="auto" hreflang={language} aria-current={language === locale ? "page" : undefined}>
                    {name}
                  </a>
                ))}
              </nav>
            </details>
          )}
          <a class="repo-link" href={repositoryUrl} aria-label={labels.github} title={labels.github}>
            <svg aria-hidden="true" fill="currentColor" height="20" viewBox="0 0 24 24" width="20">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>
    <main id="content" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <a class="brand" href={brandHome}>
            <span class="brand-mark" aria-hidden="true" set:html={loomLogo} />
            <span lang="en" dir="ltr">ClickHouse Loom</span>
          </a>
        </div>
        <nav aria-label={labels.resources}>
          <a {...start}>{labels.start}</a>
          <a href={repositoryUrl}>GitHub</a>
          <a href={`${repositoryUrl}/releases`} hreflang="en">{labels.releases}</a>
          <a href="/docs/benchmarks/results" hreflang="en">{labels.benchmarks}</a>
          <a href="/telemetry" hreflang="en">{labels.telemetry}</a>
        </nav>
        <nav class="footer-languages" aria-labelledby="footer-language-label">
          <span id="footer-language-label">{labels.docsLanguages}</span>
          {locales.map(({ name, language, docs }) => docs && (
            <a href={docs} lang={language} dir="auto" hreflang={language}>{name}</a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    background: #141413;
    color: #f5f3ed;
    font-family: system-ui, sans-serif;
    --muted: #bbb8ac;
    --accent: #ffcc00;
    --line: #35342a;
    --surface: #1d1d19;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; text-underline-offset: 0.22em; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .shell {
    width: 100%;
    max-width: 108rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 4.5rem);
  }
  .site-header, .site-footer { background: #141413; }
  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner, .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem 2rem;
    padding-block: 1.15rem;
  }
  .brand, nav { display: flex; align-items: center; gap: 0.7rem; }
  .brand { flex-shrink: 0; font-weight: 700; text-decoration: none; }
  .brand-mark { display: block; width: 2rem; height: 2rem; }
  .brand-mark svg { display: block; width: 100%; height: 100%; }
  .brand-mark .loom-logo-mark[stroke] { stroke: var(--accent); }
  .brand-mark .loom-logo-mark[fill] { fill: var(--accent); }
  .brand-mark .loom-logo-cutout { fill: #141413; }
  nav { flex-wrap: wrap; gap: 1.25rem; font-size: 0.95rem; }
  nav a { text-decoration: none; color: var(--muted); }
  .site-header nav a { display: inline-flex; align-items: center; min-height: 1.65rem; }
  nav a:hover, nav a[aria-current] { color: var(--accent); }
  .header-actions { display: flex; align-items: center; gap: 0.65rem; flex-shrink: 0; }
  .site-language { position: relative; font-size: 0.88rem; }
  .site-language summary {
    cursor: pointer;
    color: var(--muted);
    padding: 0.55rem 0.45rem;
    white-space: nowrap;
  }
  .site-language summary:hover { color: var(--accent); }
  .site-language summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .site-language-code { display: none; }
  .site-language-list {
    position: absolute;
    z-index: 2;
    inset-inline-end: 0;
    margin-top: 0.35rem;
    padding: 0.4rem;
    min-width: 11rem;
    max-block-size: calc(100dvh - 5rem);
    overflow-y: auto;
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: var(--surface);
  }
  .site-language-list a { padding: 0.35rem 0.55rem; }
  .repo-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.35rem;
    color: var(--muted);
  }
  .repo-link:hover { color: var(--accent); background: var(--surface); }
  .header-action {
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    padding: 0.6rem 0.82rem;
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-action span { color: var(--accent); margin-inline-start: 0.3rem; }
  html[dir="rtl"] :is(.header-action span, .site-panel a span) { display: inline-block; transform: scaleX(-1); }
  .header-action:hover { border-color: var(--accent); }
  .skip { position: absolute; z-index: 1; inset-inline-start: 1rem; top: -5rem; padding: 0.6rem; background: #141413; }
  .skip:focus { top: 1rem; }
  main { padding-block: clamp(2.75rem, 6vw, 6rem); }
  h1, h2, h3, p { margin: 0; }
  p, li { line-height: 1.65; color: var(--muted); }
  h1 { max-width: 18ch; font-size: clamp(2.85rem, 6vw, 6.25rem); line-height: 1.02; letter-spacing: -0.065em; }
  h2 { font-size: clamp(1.4rem, 2.35vw, 2.15rem); line-height: 1.12; letter-spacing: -0.035em; }
  h3 { font-size: 1.15rem; line-height: 1.3; letter-spacing: -0.015em; }
  html:is([lang="ar"], [lang="hi"]) :is(h1, h2, h3) { letter-spacing: normal; }
  html:is([lang="ar"], [lang="hi"]) h1 { line-height: 1.18; }
  .lead { font-size: clamp(1.08rem, 1.6vw, 1.35rem); max-width: 42rem; margin-top: 1.2rem; }
  .primary, .secondary {
    display: inline-block;
    padding: 0.75rem 1.12rem;
    border-radius: 0.35rem;
    font-weight: 700;
    text-decoration: none;
  }
  .primary { color: #141413; background: var(--accent); border: 1px solid var(--accent); }
  .primary:hover { background: #ffdd4b; }
  .secondary { border: 1px solid #5a5747; }
  .secondary:hover { border-color: var(--accent); color: var(--accent); }
  .site-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem 1.15rem; margin-top: 1.65rem; }
  .site-section { margin-top: clamp(3.25rem, 7vw, 6.25rem); padding-top: clamp(1.75rem, 3vw, 2.7rem); border-top: 1px solid var(--line); }
  .section-copy { max-width: 45rem; }
  .section-copy p { margin-top: 0.7rem; }
  .site-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1rem; margin-top: 1.35rem; }
  .site-panel { min-width: 0; padding: clamp(1.1rem, 2vw, 1.65rem); border: 1px solid var(--line); border-radius: 0.65rem; background: var(--surface); }
  .site-panel p { margin-block: 0.55rem 0.9rem; max-width: 45ch; }
  .site-panel a, .text-link { color: var(--accent); font-size: 0.96rem; font-weight: 600; }
  .site-footer { border-top: 1px solid var(--line); }
  .footer-inner { padding-block: 1.9rem; flex-wrap: wrap; }
  .footer-languages { flex-basis: 100%; border-top: 1px solid var(--line); padding-top: 1rem; }
  .footer-languages span { font-weight: 650; }
  @media (max-width: 57rem) {
    .header-inner { flex-wrap: wrap; gap: 0.85rem; }
    .header-inner .brand { width: 100%; }
    .header-inner > nav { flex: 1; min-width: 0; gap: 0.5rem 1.05rem; }
    .homepage-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "brand actions" "nav nav";
      column-gap: 0.45rem;
    }
    .homepage-header .brand { grid-area: brand; width: auto; min-width: 0; }
    .homepage-header .header-actions { grid-area: actions; }
    .homepage-header > nav { grid-area: nav; }
    .header-action { display: none; }
  }
  @media (max-width: 34rem) {
    .site-language-name { display: none; }
    .site-language-code { display: inline; }
    .site-language summary { min-height: 2.75rem; padding: 0.7rem 0.3rem; }
  }
  @media (max-width: 25rem) {
    .header-inner > nav, .footer-inner nav { font-size: 0.85rem; gap: 0.5rem 0.75rem; }
    .homepage-header > nav { gap: 0.4rem 0.5rem; }
  }
</style>
