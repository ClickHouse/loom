---
import { Button } from "@clickhouse/click-ui/Button";
import { grains, ranges } from "../lib/adoption-view.mjs";
import AdoptionState from "./AdoptionState.astro";

interface Props {
  path: string;
  state: Record<string, string | number>;
  days: number;
  grain: string;
}

const { path, state, days, grain } = Astro.props;
const visibleGrains = Object.entries(grains).filter(([value]) => days === 30 || value !== "day");
---

<div class="chart-controls" id="chart-controls">
  <form method="post" action={path} class="control-group" aria-label="Reporting window">
    <AdoptionState state={state} omit={["days", "grain", "domain_page"]} />
    {ranges.map((range) => (
      <Button
        {...{ name: "days", value: String(range) }}
        type={range === days ? "secondary" : "empty"}
        htmlType="submit"
        aria-pressed={range === days}
        label={range === 365 ? "1 year" : range + " days"}
      />
    ))}
  </form>
  <form method="post" action={path} class="control-group" aria-label="Chart interval">
    <AdoptionState state={state} omit={["grain"]} />
    {visibleGrains.map(([value, label]) => (
      <Button
        {...{ name: "grain", value }}
        type={value === grain ? "secondary" : "empty"}
        htmlType="submit"
        aria-pressed={value === grain}
        label={label}
      />
    ))}
  </form>
</div>

<style>
  .chart-controls, .control-group { display: flex; flex-wrap: wrap; align-items: center; }
  .chart-controls { gap: 0.55rem 0.9rem; }
  .control-group { gap: 0.15rem; padding: 0.15rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .control-group :global(button) { min-block-size: 2.5rem; padding-inline: 0.7rem; border-color: transparent; font-size: 0.875rem; }
  .control-group :global(button[aria-pressed="false"]) { color: var(--muted); }
  .control-group :global(button[aria-pressed="true"]) { background: var(--surface-raised); color: var(--click-global-color-text-default); }
</style>
