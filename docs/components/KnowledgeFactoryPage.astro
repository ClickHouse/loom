---
import SiteFrame from "./SiteFrame.astro";
import { documentationLink } from "./documentation-link";
import { knowledgeFactoryCopy } from "./knowledge-factory-copy";
import { knowledgeFactoryAlternates, siteLocales } from "./site-locales";

interface Props {
  locale: keyof typeof knowledgeFactoryCopy;
}

const { locale } = Astro.props;
const copy = knowledgeFactoryCopy[locale];
const path = siteLocales[locale].knowledgeFactory;

function guide(path: string, label: string) {
  const link = documentationLink(locale, path);
  return { ...link, label: link.hreflang === locale ? label : `${label} (${copy.englishLabel})` };
}

const evidence = [
  { ...copy.source, ...guide("/use-cases/document-search", copy.source.label) },
  { ...copy.lesson, ...guide("/use-cases/agent-memory", copy.lesson.label) },
  { ...copy.code, ...guide("/use-cases/memory-linked-to-code", copy.code.label) },
];
const evaluate = guide("/getting-started/evaluate", copy.evaluate);
const walkthrough = guide("/use-cases/knowledge-factory#run-a-knowledge-factory-walkthrough", copy.walkthrough);
---

<SiteFrame title={copy.title} description={copy.description} path={path} locale={locale} alternates={knowledgeFactoryAlternates}>
  <h1>{copy.heading}</h1>
  <p class="lead">{copy.lead}</p>

  <section class="site-section" aria-labelledby="evidence-title">
    <div class="section-copy">
      <h2 id="evidence-title">{copy.evidenceHeading}</h2>
    </div>
    <div class="site-grid">
      {evidence.map(({ title, detail, href, hreflang, label }) => (
        <article class="site-panel">
          <h3>{title}</h3>
          <p>{detail}</p>
          <a href={href} hreflang={hreflang}>{label} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="site-section" aria-labelledby="pilot-title">
    <div class="section-copy">
      <h2 id="pilot-title">{copy.pilotHeading}</h2>
      <p>{copy.pilot}</p>
    </div>
    <div class="site-actions">
      <a class="primary" href={evaluate.href} hreflang={evaluate.hreflang}>{evaluate.label}</a>
      <a class="text-link" href={walkthrough.href} hreflang={walkthrough.hreflang}>{walkthrough.label}</a>
    </div>
  </section>
</SiteFrame>

<style>
  h1 { text-wrap: balance; overflow-wrap: anywhere; }
</style>
