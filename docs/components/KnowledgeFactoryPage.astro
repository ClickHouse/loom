---
import { GridContainer } from "@clickhouse/click-ui/GridContainer";
import { Icon } from "@clickhouse/click-ui/Icon";
import { Link } from "@clickhouse/click-ui/Link";
import { Panel } from "@clickhouse/click-ui/Panel";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import SiteFrame from "./SiteFrame.astro";
import { documentationLink } from "./documentation-link";
import { knowledgeFactoryCopy } from "./knowledge-factory-copy";
import { knowledgeFactoryAlternates, siteLocales } from "./site-locales";

interface Props {
  locale: keyof typeof knowledgeFactoryCopy;
}

const { locale } = Astro.props;
const copy = knowledgeFactoryCopy[locale];
const path = siteLocales[locale].knowledgeFactory;

function guide(path: string, label: string) {
  const link = documentationLink(locale, path);
  return { ...link, label: link.hreflang === locale ? label : `${label} (${copy.englishLabel})` };
}

const evidence = [
  { ...copy.source, ...guide("/use-cases/document-search", copy.source.label) },
  { ...copy.lesson, ...guide("/use-cases/agent-memory", copy.lesson.label) },
  { ...copy.code, ...guide("/use-cases/memory-linked-to-code", copy.code.label) },
];
const evaluate = guide("/getting-started/evaluate", copy.evaluate);
const walkthrough = guide("/use-cases/knowledge-factory#run-a-knowledge-factory-walkthrough", copy.walkthrough);
---

<SiteFrame title={copy.title} description={copy.description} path={path} locale={locale} alternates={knowledgeFactoryAlternates}>
  <Title type="h1" size="xl" family="brand">{copy.heading}</Title>
  <Text color="muted" className="lead">{copy.lead}</Text>
  <div class="site-actions">
    <Link className="primary" href={walkthrough.href} hrefLang={walkthrough.hreflang}>{walkthrough.label}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
    <Link className="secondary" href="#pilot-scorecard">{copy.pilotHeading}</Link>
  </div>

  <section class="site-section" aria-labelledby="evidence-title">
    <div class="section-copy">
      <Title type="h2" size="lg" id="evidence-title">{copy.evidenceHeading}</Title>
    </div>
    <GridContainer className="site-grid" isResponsive={false}>
      {evidence.map(({ title, detail, href, hreflang, label }) => (
        <Panel orientation="vertical" alignItems="start" gap="none" hasBorder role="article" className="site-panel">
          <Title type="h3" size="md">{title}</Title>
          <Text color="muted">{detail}</Text>
          <Link href={href} hrefLang={hreflang}>{label} <Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
        </Panel>
      ))}
    </GridContainer>
  </section>

  <section id="pilot-scorecard" class="site-section" aria-labelledby="pilot-title">
    <div class="section-copy">
      <Title type="h2" size="lg" id="pilot-title">{copy.pilotHeading}</Title>
      <Text color="muted">{copy.pilot}</Text>
    </div>
    <dl class="pilot-checks">
      {copy.pilotChecks.map(({ title, detail }) => (
        <div>
          <dt>{title}</dt>
          <dd>{detail}</dd>
        </div>
      ))}
    </dl>
    <div class="site-actions">
      <Link className="secondary" href={evaluate.href} hrefLang={evaluate.hreflang}>{evaluate.label}<Icon name="arrow-right" size="sm" className="link-arrow" aria-hidden="true" /></Link>
    </div>
  </section>
</SiteFrame>

<style>
  .site-panel { display: flex; flex-direction: column; align-items: start; }
  .site-panel a { margin-top: auto; }
  .pilot-checks { margin: 1.5rem 0 0; }
  .pilot-checks > div {
    display: grid;
    grid-template-columns: clamp(10rem, 23%, 16rem) minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    border-top: 1px solid var(--line);
    padding: 0.85rem 0;
  }
  .pilot-checks dt { font-weight: 650; }
  .pilot-checks dd { margin: 0; color: var(--muted); }
  @media (max-width: 40rem) {
    .pilot-checks > div { grid-template-columns: 1fr; }
  }
</style>
