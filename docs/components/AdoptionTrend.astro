---
import { periodOffset } from "../lib/adoption-view.mjs";

interface Props {
  rows: { day: string; value: number; days?: number }[];
  label: string;
  grain?: "month" | "week" | "day";
}

const { rows, label, grain = "day" } = Astro.props;
const first = rows[0].day;
const last = rows[rows.length - 1].day;
const maximum = Math.max(1, ...rows.map(({ value }) => value));
const dayIndex = (day: string) => periodOffset(first, day, grain) + 1;
const periodLabel = (day: string) => (grain === "month" ? day.slice(0, 7) : day);
const showCoverage = rows.some(({ days }) => days !== undefined);
const numbers = new Intl.NumberFormat("en-US");
---

<figure>
  <div class="bars" style={`--days:${dayIndex(last)}`} aria-hidden="true">
    {rows.map(({ day, value }) => (
      <span title={`${periodLabel(day)} · ${numbers.format(value)}`} style={`grid-column:${dayIndex(day)}; --height:${value / maximum * 100}%`}></span>
    ))}
  </div>
  <figcaption>
    <time datetime={first}>{periodLabel(first)}</time>
    {last !== first && <time datetime={last}>{periodLabel(last)}</time>}
  </figcaption>
  <details>
    <summary>{label} by {grain}</summary>
    <table>
      <thead><tr>
        <th scope="col">UTC period</th>
        <th scope="col">{label}</th>
        {showCoverage && <th scope="col">Days reported</th>}
      </tr></thead>
      <tbody>
        {rows.map(({ day, value, days }) => <tr>
          <th scope="row">{periodLabel(day)}</th><td>{numbers.format(value)}</td>
          {showCoverage && <td>{days}</td>}
        </tr>)}
      </tbody>
    </table>
  </details>
</figure>

<style>
  figure { margin: 1.45rem 0 0; }
  .bars {
    height: 8rem;
    display: grid;
    grid-template-columns: repeat(var(--days), minmax(0, 1fr));
    align-items: end;
    gap: min(0.25rem, calc(20% / var(--days)));
    border-bottom: 1px solid var(--line);
  }
  .bars span {
    height: var(--height);
    min-height: 1px;
    grid-row: 1;
    background: var(--accent);
    border-radius: 2px 2px 0 0;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  details { margin-top: 0.9rem; color: var(--muted); }
  summary { cursor: pointer; font-size: 0.85rem; }
  table { margin-top: 0.7rem; width: 100%; border-collapse: collapse; }
  th, td { padding: 0.45rem 0; border-bottom: 1px solid var(--line); text-align: left; }
  td, thead th:last-child { text-align: right; }
</style>
