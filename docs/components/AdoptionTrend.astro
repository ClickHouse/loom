---
import { Table } from "@clickhouse/click-ui/Table";
import { periodOffset } from "../lib/adoption-view.mjs";

interface Props {
  rows: { day: string; value: number; days?: number; current?: boolean; partial?: boolean }[];
  label: string;
  grain?: "month" | "week" | "day";
  mode?: "line" | "bars";
  color?: "accent" | "info";
  showTable?: boolean;
  axisMaximum?: number;
  axisStart?: string;
  axisEnd?: string;
  compact?: boolean;
  showNotes?: boolean;
}

const {
  rows,
  label,
  grain = "day",
  mode = "bars",
  color = "accent",
  showTable = true,
  axisMaximum = 0,
  axisStart,
  axisEnd,
  compact = false,
  showNotes = true,
} = Astro.props;
const firstDay = rows[0].day;
const lastDay = rows[rows.length - 1].day;
const first = axisStart && axisStart < firstDay ? axisStart : firstDay;
const last = axisEnd && axisEnd > lastDay ? axisEnd : lastDay;
const offset = (day: string) => periodOffset(first, day, grain);
const intervals = offset(last);
const rawMaximum = Math.max(1, axisMaximum, ...rows.map(({ value }) => value));
const tick = 10 ** Math.floor(Math.log10(Math.max(1, rawMaximum / 2)));
const maximum = Math.ceil(rawMaximum / (2 * tick)) * 2 * tick;
const yPosition = (value: number) => 100 - (value * 100) / maximum;
const xPosition = (day: string) => (intervals ? (offset(day) * 100) / intervals : 50);
const date = new Intl.DateTimeFormat("en", {
  month: "short",
  ...(grain === "month"
    ? { year: "numeric" }
    : { day: "numeric", ...(first.slice(0, 4) !== last.slice(0, 4) && { year: "numeric" }) }),
  timeZone: "UTC",
});
const formatDay = (day: string) => date.format(Date.parse(day));
const number = new Intl.NumberFormat("en-US");
const tickFormat = new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 });
const coverage = rows.some(({ days }) => days !== undefined);
const pending = rows.some(({ current }) => current);
const partialCoverage = rows.some(({ partial }) => partial);
const missing = rows.length < intervals + 1;
const points =
  mode === "line"
    ? rows.map((row) => ({
        ...row,
        bucket: offset(row.day),
        x: xPosition(row.day).toFixed(3),
        y: yPosition(row.value).toFixed(3),
      }))
    : [];
const runs: { points: typeof points; partial?: boolean }[] = [];
for (const point of points) {
  const run = runs.at(-1);
  const previous = run?.points.at(-1);
  if (!run || !previous || point.bucket !== previous.bucket + 1) {
    runs.push({ points: [point], partial: point.current });
  } else if (point.current && !run.partial) {
    runs.push({ points: [previous, point], partial: true });
  } else {
    run.points.push(point);
  }
}
const edge = ({ x, y }: (typeof points)[number], shift: string) => `${x}% calc(${y}% ${shift} 1px)`;
const segments = runs
  .filter(({ points }) => points.length > 1)
  .map(({ points, partial }) => ({
    partial,
    clip: `polygon(${[...points.map((point) => edge(point, "-")), ...points.toReversed().map((point) => edge(point, "+"))].join(",")})`,
  }));
const markers = points.filter(
  ({ bucket, current }, index) =>
    points.length <= 31 ||
    current ||
    points[index - 1]?.bucket !== bucket - 1 ||
    points[index + 1]?.bucket !== bucket + 1,
);
---

<figure class:list={["trend", color, mode, { compact }]} aria-label={label + " by " + grain}>
  <div class="plot" aria-hidden="true">
    <div class="scale">
      <span>{tickFormat.format(maximum)}</span>
      <span>{tickFormat.format(maximum / 2)}</span>
      <span>0</span>
    </div>
    {mode === "line" ? (
      <div class="marks">
        {segments.map(({ clip, partial }) => <span class:list={["segment", { partial }]} style={"clip-path:" + clip} />)}
        {markers.map(({ day, value, current, x, y }) => (
          <span class:list={["point", { current }]} title={formatDay(day) + " · " + number.format(value)} style={"left:" + x + "%;top:" + y + "%"} />
        ))}
      </div>
    ) : (
      <div class="marks columns" style={"--intervals:" + (intervals + 1)}>
        {rows.map(({ day, value, current, partial }) => (
          <div class="column" title={formatDay(day) + " · " + number.format(value)} style={"grid-column:" + (offset(day) + 1)}>
            <span class:list={["bar", { current, "partial-coverage": partial }]} style={"--height:" + (100 - yPosition(value)) + "%"} />
          </div>
        ))}
      </div>
    )}
  </div>
  <figcaption>
    <div class="dates" aria-hidden="true">
      <time datetime={first}>{formatDay(first)}</time>
      {last !== first && <time datetime={last}>{formatDay(last)}</time>}
    </div>
    {showNotes && (pending || missing || partialCoverage) && <div class="plot-note">
      {pending && <span><i class="partial-key"></i>Period in progress</span>}
      {partialCoverage && <span><i class="coverage-key"></i>Partial month coverage</span>}
      {missing && <span>Gaps show periods with no report.</span>}
    </div>}
  </figcaption>
  {showTable && <details>
    <summary aria-label={"View data table for " + label}>View data table</summary>
    <Table
      aria-label={label + " by " + grain}
      size="sm"
      mobileLayout="scroll"
      headers={[{ label: "UTC period", scope: "col" }, { label, scope: "col" }, ...(coverage ? [{ label: "Days reported", scope: "col" }] : [])]}
      rows={rows.map(({ day, value, days }) => ({
        id: day,
        items: [{ label: day }, { label: number.format(value) }, ...(coverage ? [{ label: days ?? "—" }] : [])],
      }))}
    />
  </details>}
</figure>

<style>
  .trend {
    --plot-color: var(--accent);
    margin: 0.85rem 0 0;
    inline-size: 100%;
    min-inline-size: 0;
    font-variant-numeric: tabular-nums;
  }
  .trend.info { --plot-color: var(--click-alert-color-text-info); }
  .plot { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.65rem; }
  .scale {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: end;
    align-self: stretch;
    margin-block: -0.5em;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .marks {
    position: relative;
    block-size: clamp(7rem, 13vw, 13rem);
    background: linear-gradient(var(--line), var(--line)) top / 100% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) bottom / 100% 1px no-repeat;
  }
  .compact .marks { block-size: clamp(5.5rem, 8vw, 8rem); }
  .segment { position: absolute; inset: 0; background: var(--plot-color); pointer-events: none; }
  .segment.partial { opacity: 0.45; }
  .point {
    position: absolute;
    inline-size: clamp(0.23rem, 1vw, 0.4rem);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--plot-color);
  }
  .point.current { border: 1px solid var(--plot-color); background: var(--surface); }
  .columns {
    display: grid;
    gap: min(0.5rem, calc(20% / var(--intervals)));
    grid-template-columns: repeat(var(--intervals), minmax(0, 1fr));
  }
  .column { grid-row: 1; display: flex; flex-direction: column-reverse; min-inline-size: 0; }
  .bar { inline-size: 100%; max-inline-size: 2.5rem; block-size: var(--height); margin-inline: auto; background: var(--plot-color); }
  .bar.current { background: color-mix(in srgb, var(--plot-color) 48%, var(--surface)); }
  .bar.partial-coverage, .coverage-key {
    background: repeating-linear-gradient(135deg, var(--plot-color) 0 1px, var(--surface) 1px 4px);
  }
  .dates { display: flex; justify-content: space-between; gap: 0.45rem; padding-inline-start: 2rem; margin-block-start: 0.45rem; }
  figcaption { color: var(--muted); font-size: 0.77rem; }
  .plot-note { display: flex; flex-wrap: wrap; gap: 0.4rem 0.8rem; margin-block-start: 0.6rem; }
  .plot-note span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .plot-note i { inline-size: 0.7rem; block-size: 0.55rem; border: 1px solid var(--plot-color); border-radius: 1px; }
  .partial-key { background: color-mix(in srgb, var(--plot-color) 48%, var(--surface)); }
  .line .partial-key { border-radius: 50%; background: var(--surface); }
  details { margin-block-start: 0.8rem; }
  summary { cursor: pointer; padding-block: 0.5rem; color: var(--click-global-color-text-link-default); font-size: 0.86rem; }
</style>
