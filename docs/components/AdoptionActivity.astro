---
import { Panel } from "@clickhouse/click-ui/Panel";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import { activityPoints, periodStart, type ChartGrain } from "../lib/adoption-chart-series.mjs";
import AdoptionMetricPair from "./AdoptionMetricPair.astro";
import AdoptionTrend from "./AdoptionTrend.astro";

interface Props {
  rows: {
    period: string;
    operations: number;
    active: number;
    days_reported: number;
    complete_days_reported?: number;
    current: boolean;
    active_accounts?: number | null;
    accounts_days_reported?: number;
    serving_processes?: number | null;
    processes_days_reported?: number;
  }[];
  grain: ChartGrain;
  rangeStart?: string;
  rangeEnd?: string;
  view: "activity" | "accounts" | "instances" | "requests";
  firstAccountReport?: string;
  showProcesses?: boolean;
}

const { rows, grain, rangeStart, rangeEnd, view, firstAccountReport, showProcesses } = Astro.props;
const accountPoints = activityPoints(rows, "active_accounts", grain, "accounts_days_reported");
const processPoints = activityPoints(rows, "serving_processes", grain, "processes_days_reported");
---

{view === "activity" && (
  <AdoptionMetricPair
    label="Active installations"
    description="Distinct installations with a successful request."
    rows={activityPoints(rows, "active", grain)}
    {grain}
    kind="gauge"
    axisStart={rangeStart}
    axisEnd={rangeEnd}
  />
)}
{view === "requests" && (
  <AdoptionMetricPair
    label="Successful requests"
    rows={activityPoints(rows, "operations", grain)}
    {grain}
    growthLabel="Cumulative requests"
    growthFirst
    axisStart={rangeStart}
    axisEnd={rangeEnd}
  />
)}
{view === "accounts" && (
    <AdoptionMetricPair
      label="Active users"
      description={
        "Authenticated users with successful requests, including service identities." +
        (firstAccountReport ? ` The first reported count in this window was on ${firstAccountReport} UTC.` : "")
      }
      observedLabel={grain === "day" ? "Daily total" : "Peak daily total"}
      rows={accountPoints}
      {grain}
      kind="gauge"
      axisStart={rangeStart}
      axisEnd={rangeEnd}
    />
  )}
{view === "instances" && (
  <Panel orientation="vertical" alignItems="start" padding="lg" gap="xs" hasBorder fillWidth>
    <Title type="h3" size="sm">Active instances</Title>
    <Text size="sm" color="muted">
      Loom serving processes with successful requests across reporting installations. Restarts and workers can count separately.
      {grain !== "day" && " Each point shows the peak daily total."}
    </Text>
    <AdoptionTrend
      label="Active instances over time"
      rows={processPoints}
      {grain}
      mode="line"
      axisStart={rangeStart && periodStart(rangeStart, grain)}
      axisEnd={rangeEnd && periodStart(rangeEnd, grain)}
      emptyMessage="No instance counts were reported in this window."
    />
  </Panel>
)}
{view === "activity" && (showProcesses || processPoints.length > 0) && (
    <AdoptionMetricPair
      label="Serving processes"
      description="Processes that handled successful requests. Restarts and workers can contribute."
      rows={processPoints}
      {grain}
      kind="gauge"
      axisStart={rangeStart}
      axisEnd={rangeEnd}
    />
  )}
