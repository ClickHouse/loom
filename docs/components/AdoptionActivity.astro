---
import type { ChartGrain } from "../lib/adoption-chart-series.mjs";
import { activityPoints } from "../lib/adoption-chart-series.mjs";
import AdoptionMetricPair from "./AdoptionMetricPair.astro";

interface Props {
  rows: {
    period: string;
    operations: number;
    active: number;
    reporting: number;
    days_reported: number;
    current: boolean;
    active_accounts?: number | null;
    accounts_days_reported?: number;
    serving_processes?: number | null;
    processes_days_reported?: number;
  }[];
  grain: ChartGrain;
  rangeStart?: string;
  rangeEnd?: string;
  showAccounts?: boolean;
  showProcesses?: boolean;
}

const { rows, grain, rangeStart, rangeEnd, showAccounts, showProcesses } = Astro.props;
const accountPoints = activityPoints(rows, "active_accounts", grain, "accounts_days_reported");
const processPoints = activityPoints(rows, "serving_processes", grain, "processes_days_reported");
---

<div class="activity-charts">
  <AdoptionMetricPair
    label="Active installations"
    description="Distinct installations with a successful request."
    rows={activityPoints(rows, "active", grain)}
    {grain}
    kind="gauge"
    axisStart={rangeStart}
    axisEnd={rangeEnd}
  />
  <AdoptionMetricPair
    label="Reporting installations"
    description="Distinct installations that sent an adoption report."
    rows={activityPoints(rows, "reporting", grain)}
    {grain}
    kind="gauge"
    axisStart={rangeStart}
    axisEnd={rangeEnd}
  />
  <AdoptionMetricPair
    label="Successful requests"
    description="Successful requests across reporting installations."
    rows={activityPoints(rows, "operations", grain)}
    {grain}
    axisStart={rangeStart}
    axisEnd={rangeEnd}
  />
  {(showAccounts || accountPoints.length > 0) && (
    <AdoptionMetricPair
      label="Active accounts"
      description="Reported active account counts across participating installations."
      rows={accountPoints}
      {grain}
      kind="gauge"
      axisStart={rangeStart}
      axisEnd={rangeEnd}
    />
  )}
  {(showProcesses || processPoints.length > 0) && (
    <AdoptionMetricPair
      label="Serving processes"
      description="Processes that handled successful requests. Restarts and workers can contribute."
      rows={processPoints}
      {grain}
      kind="gauge"
      axisStart={rangeStart}
      axisEnd={rangeEnd}
    />
  )}
</div>

<style>
  .activity-charts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .activity-charts > :global(.metric-pair) {
    flex: 1 1 min(100%, 24rem);
  }
</style>
