---
import { Panel } from "@clickhouse/click-ui/Panel";
import { Table } from "@clickhouse/click-ui/Table";
import { Text } from "@clickhouse/click-ui/Text";
import { Title } from "@clickhouse/click-ui/Title";
import AdoptionTrend from "./AdoptionTrend.astro";

interface Props {
  rows: {
    period: string;
    operations: number;
    active: number;
    reporting: number;
    estimate: number | null;
    days_reported: number;
    current: boolean;
  }[];
  grain: "day" | "week" | "month";
}

const { rows, grain } = Astro.props;
const number = new Intl.NumberFormat("en-US");
const hasActivity = rows.some(({ active, operations }) => active > 0 || operations > 0);
const hasEstimate = rows.some(({ estimate, operations }) => estimate !== null && estimate > operations);
const hasCurrentPeriod = rows.some(({ current }) => current);
const columns = [
  "Period start (UTC)",
  "Reporting installations",
  "Active installations",
  "Successful requests",
  ...(hasEstimate ? ["Projected requests"] : []),
  "Days reported",
];
---

{hasActivity ? <>
<Text className="activity-guide" size="sm" color="muted">
  Counts use completed UTC days.{grain !== "day" && " Charts show periods that begin within the selected window."}
  {" Gaps indicate periods without a report."}
  {hasCurrentPeriod && " Hollow markers show activity to date in the current period."}
</Text>
<div class="charts">
  <Panel className="chart" orientation="vertical" alignItems="start" padding="lg" gap="none" hasBorder fillWidth>
    <Title type="h3" size="sm">Active installations</Title>
    <Text size="sm" color="muted">Distinct installations with at least one successful request in the period. An installation may be active in multiple periods.</Text>
    <AdoptionTrend
      rows={rows.map(({ period, active, current }) => ({ day: period, value: active, current }))}
      label="Active installations"
      grain={grain}
      mode="line"
      color="info"
      showNotes={false}
      showTable={false}
    />
  </Panel>
  <Panel className="chart" orientation="vertical" alignItems="start" padding="lg" gap="none" hasBorder fillWidth>
    <Title type="h3" size="sm">Successful requests</Title>
    <Text size="sm" color="muted">Successful Loom requests across reporting installations in the period.</Text>
    <AdoptionTrend
      rows={rows.map(({ period, operations, current }) => ({ day: period, value: operations, current }))}
      label="Successful requests"
      grain={grain}
      mode="line"
      showNotes={false}
      showTable={false}
    />
  </Panel>
</div></> : (
  <Text size="sm" color="muted">The reporting installations recorded no successful requests in these periods.</Text>
)}

<details class="data" open={!hasActivity}>
  <summary>View installation and request data</summary>
  <Table
    aria-label="Installation and request data"
    size="sm"
    mobileLayout="scroll"
    headers={columns.map((label) => ({ label, scope: "col" }))}
    rows={rows.map(({ period, reporting, active, operations, estimate, days_reported, current }) => ({
      id: period,
      items: [
        period + (current ? " to date" : ""),
        number.format(reporting),
        number.format(active),
        number.format(operations),
        ...(hasEstimate ? [estimate === null ? "—" : number.format(estimate)] : []),
        days_reported,
      ].map((label) => ({ label })),
    }))}
  />
</details>

<style>
  .charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  .chart { min-inline-size: 0; }
  .chart p { margin-block-start: 0.3rem; }
  :global(.activity-guide) { margin-block-end: 0.7rem; }
  .data { margin-block-start: 0.75rem; }
  summary { cursor: pointer; padding-block: 0.55rem; color: var(--click-global-color-text-link-default); font-size: 0.86rem; }
  @media (max-width: 46rem) { .charts { grid-template-columns: minmax(0, 1fr); } }
</style>
